{
  "name": "rede-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:local:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-postgres.ps1",
    "db:local:start": "powershell -ExecutionPolicy Bypass -File scripts/start-local-postgres.ps1",
    "db:local:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-local-postgres.ps1"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.539.0",
    "next": "^15.4.6",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.17.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.6",
    "prisma": "^6.14.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "node --import ./scripts/patch-node-os.mjs --import tsx prisma/seed.ts"
  }
}
