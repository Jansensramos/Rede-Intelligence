model SupplierQualification {
  id                String                      @id @default(cuid())
  organizationId    String                      @map("organization_id")
  supplierId        String                      @map("supplier_id")
  category          String
  status            SupplierQualificationStatus @default(PENDING)
  validFrom         DateTime?                   @map("valid_from") @db.Date
  validUntil        DateTime?                   @map("valid_until") @db.Date
  technicalCapacity String?                     @map("technical_capacity") @db.Text
  insuranceNotes    String?                     @map("insurance_notes") @db.Text
  restrictions      String?                     @db.Text
  evidence          Json?
  reviewedById      String?                     @map("reviewed_by_id")
  reviewedAt        DateTime?                   @map("reviewed_at")
  createdById       String                      @map("created_by_id")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier          Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([supplierId, category])
  @@index([organizationId, status, validUntil])
  @@map("supplier_qualifications")
}

model ProcurementNeed {
  id                 String                    @id @default(cuid())
  organizationId     String                    @map("organization_id")
  companyId          String?                   @map("company_id")
  projectId          String                    @map("project_id")
  operatingUnitId    String?                   @map("operating_unit_id")
  costCenterId       String?                   @map("cost_center_id")
  economicItemId     String?                   @map("economic_item_id")
  budgetLineItemId   String?                   @map("budget_line_item_id")
  scheduleActivityId String?                   @map("schedule_activity_id")
  code               String
  description        String
  specification      String                    @db.Text
  quantity           Decimal                   @db.Decimal(18, 4)
  unit               String
  requiredAt         DateTime                  @map("required_at") @db.Date
  expectedLeadDays   Int                       @default(30) @map("expected_lead_days")
  bufferDays         Int                       @default(7) @map("buffer_days")
  priority           ProcurementPriority       @default(NORMAL)
  origin             ProcurementNeedOrigin     @default(MANUAL)
  originReference    String?                   @map("origin_reference")
  originMetadata     Json?                     @map("origin_metadata")
  requesterId        String                    @map("requester_id")
  technicalOwnerId   String?                   @map("technical_owner_id")
  status             ProcurementNeedStatus     @default(IDENTIFIED)
  discardedReason    String?                   @map("discarded_reason")
  createdById        String                    @map("created_by_id")
  updatedById        String                    @map("updated_by_id")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company            Company?                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  operatingUnit      ProjectOperatingUnit?     @relation(fields: [operatingUnitId], references: [id], onDelete: Restrict)
  costCenter         CostCenter?               @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  economicItem       EconomicItem?             @relation(fields: [economicItemId], references: [id], onDelete: Restrict)
  budgetLineItem     BudgetLineItem?           @relation(fields: [budgetLineItemId], references: [id], onDelete: Restrict)
  scheduleActivity   ScheduleActivity?         @relation(fields: [scheduleActivityId], references: [id], onDelete: Restrict)
  requisitionItems   PurchaseRequisitionItem[]

  @@unique([projectId, code])
  @@index([organizationId, projectId, status, requiredAt])
  @@index([scheduleActivityId, requiredAt])
  @@map("procurement_needs")
}

model PurchaseRequisition {
  id                 String                     @id @default(cuid())
  organizationId     String                     @map("organization_id")
  companyId          String?                    @map("company_id")
  projectId          String                     @map("project_id")
  number             String
  title              String
  justification      String?                    @db.Text
  status             PurchaseRequisitionStatus  @default(DRAFT)
  requesterId        String                     @map("requester_id")
  buyerId            String?                    @map("buyer_id")
  technicalOwnerId   String?                    @map("technical_owner_id")
  requestedAt        DateTime?                  @map("requested_at")
