model User {
  id                     String                       @id @default(cuid())
  email                  String                       @unique
  name                   String
  passwordHash           String                       @map("password_hash")
  isActive               Boolean                      @default(true) @map("is_active")
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  memberships            OrganizationMembership[]     @relation("MembershipUser")
  membershipsInvited     OrganizationMembership[]     @relation("MembershipInvitedBy")
  sessions               Session[]
  projectsCreated        Project[]                    @relation("ProjectCreatedBy")
  projectsUpdated        Project[]                    @relation("ProjectUpdatedBy")
  studiesCreated         ViabilityStudy[]             @relation("StudyCreatedBy")
  studiesUpdated         ViabilityStudy[]             @relation("StudyUpdatedBy")
  versionsCreated        StudyVersion[]               @relation("VersionCreatedBy")
  versionsUpdated        StudyVersion[]               @relation("VersionUpdatedBy")
  assumptionsCreated     AssumptionSnapshot[]         @relation("AssumptionCreatedBy")
  assumptionsUpdated     AssumptionSnapshot[]         @relation("AssumptionUpdatedBy")
  scenariosCreated       Scenario[]                   @relation("ScenarioCreatedBy")
  scenariosUpdated       Scenario[]                   @relation("ScenarioUpdatedBy")
  calculationRuns        CalculationRun[]
  findingsCreated        RiskFinding[]
  recommendationsCreated Recommendation[]
  sensitivityRuns        SensitivityAnalysis[]
  redTeamRuns            RedTeamRun[]
  scoresCreated          Score[]
  actualEntries          ActualEntry[]
  aiRuns                 AIAnalysisRun[]
  policiesCreated        InvestmentPolicy[]           @relation("PolicyCreatedBy")
  policiesUpdated        InvestmentPolicy[]           @relation("PolicyUpdatedBy")
  assumptionEntries      AssumptionEntry[]
  scenarioOverrides      ScenarioAssumptionOverride[]
  auditLogs              AuditLog[]
  landAssetsCreated      LandAsset[]                  @relation("LandAssetCreatedBy")
  landAssetsUpdated      LandAsset[]                  @relation("LandAssetUpdatedBy")
  landStudiesCreated     LandStudy[]                  @relation("LandStudyCreatedBy")
  landStudiesUpdated     LandStudy[]                  @relation("LandStudyUpdatedBy")
  landVersionsCreated    LandStudyVersion[]           @relation("LandVersionCreatedBy")
  landDocumentsCreated   LandDocument[]
  landAuditLogs          LandAuditLog[]
  budgetsCreated         Budget[]                     @relation("BudgetCreatedBy")
  budgetsUpdated         Budget[]                     @relation("BudgetUpdatedBy")
  budgetsApproved        Budget[]                     @relation("BudgetApprovedBy")

  @@map("users")
}

model OrganizationMembership {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  role           MembershipRole
  invitedById    String?        @map("invited_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?          @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Session {
  id             String       @id @default(cuid())
  tokenHash      String       @unique @map("token_hash")
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  expiresAt      DateTime     @map("expires_at")
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([organizationId, expiresAt])
  @@map("sessions")
}

model InvestmentPolicy {
  id                   String         @id @default(cuid())
  organizationId       String         @map("organization_id")
  name                 String
  version              Int
  isActive             Boolean        @default(true) @map("is_active")
  minimumMarginRate    Decimal?       @map("minimum_margin_rate") @db.Decimal(9, 6)
  minimumRoiRate       Decimal?       @map("minimum_roi_rate") @db.Decimal(9, 6)
  minimumIrrRate       Decimal?       @map("minimum_irr_rate") @db.Decimal(9, 6)
  maximumExposure      Decimal?       @map("maximum_exposure") @db.Decimal(20, 2)
  maximumPaybackMonths Int?           @map("maximum_payback_months")
  minimumPreSalesRate  Decimal?       @map("minimum_pre_sales_rate") @db.Decimal(9, 6)
  createdById          String         @map("created_by_id")
  updatedById          String         @map("updated_by_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
