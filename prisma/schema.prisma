  @@index([organizationId, packageId, createdAt])
  @@index([entityType, entityId])
  @@map("design_audit_logs")
}

// ============================================================================
// FASE 9B — FINANCEIRO, TESOURARIA, CONTAS A PAGAR/RECEBER E FLUXO OPERACIONAL
// ============================================================================
// Cadeia: Base Aprovada -> Orçamento Oficial -> Cronograma -> Obrigação
//   -> Conta a Pagar/Receber -> Parcela -> Pagamento/Recebimento
//   -> Transação Bancária -> Conciliação -> Realizado -> Projeção Atualizada
//
// costCenterId/economicItemId/budgetLineItemId/scheduleActivityId são
// referências reais (FK) para permitir drill-down e evitar dupla contagem
// entre previsão (Fase 9A) e compromisso concreto (Fase 9B).

enum PartyStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DISPUTED
}

enum PartyType {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum BankAccountType {
  OPERATIONAL
  COLLECTIONS
  PAYMENTS
  FUNDING
  LINKED
  ESCROW
  RESERVE
  INVESTMENT
  OTHER
}

enum BankAccountRestriction {
  FREE
  RESTRICTED
}

enum BankAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum ObligationNature {
  PAYABLE
  RECEIVABLE
}

enum ObligationOrigin {
  MANUAL
  BUDGET
  CONTRACT
  MEASUREMENT
  PURCHASE
  SALE
  TAX
  FUNDING
  LEGAL
  INTERCOMPANY
  INTEGRATION
  OTHER
}

enum ObligationStatus {
  PENDING
  CONVERTED
  CANCELLED
}

enum PayableInstallmentStatus {
  PREVISTA
  PROGRAMADA
  AGUARDANDO_APROVACAO
  APROVADA
  PARCIALMENTE_PAGA
  PAGA
  CANCELADA
}

enum ReceivableInstallmentStatus {
  PREVISTA
  EMITIDA
  PARCIALMENTE_RECEBIDA
  RECEBIDA
  RENEGOCIADA
  CANCELADA
}

enum PaymentMethod {
  TRANSFER
  BOLETO
  CHEQUE
  CASH
  CARD
  PIX
  OTHER
}

enum PaymentEventStatus {
  PENDING
  PROCESSED
  CLEARED
  FAILED
  REVERSED
}

enum BankTransactionDirection {
  DEBIT
  CREDIT
}

enum BankTransactionOrigin {
  MANUAL
  IMPORT_OFX
  IMPORT_CSV
  API
}

enum BankTransactionStatus {
  RECEIVED
  CANDIDATE
  RECONCILED
  MANUAL_REVIEW
  UNRECONCILED
  DISPUTED
}

enum ReconciliationMatchType {
  PAYABLE_PAYMENT
  RECEIVABLE_PAYMENT
  INTERCOMPANY
  ADJUSTMENT
}

enum ReconciliationConfidence {
  ALTA
  MEDIA
  BAIXA
}

enum ReconciliationStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum IntercompanyNature {
  APORTE
  MUTUO
  ADIANTAMENTO
  RATEIO
  REEMBOLSO
  TRANSFERENCIA
  OUTRA
}

enum IntercompanyStatus {
  PENDING
  APPROVED
  RECORDED
  CONSOLIDATED
  CANCELLED
}

enum FinancialIndexName {
  IPCA
  INCC
  IGP_M
  CUSTOM
}

enum FinancialIndexSource {
  IBGE
  FIPE
  MANUAL
  EXTERNAL_API
}

enum FinancialIndexReliability {
  CONFIRMED
  PROJECTED
  ESTIMATED
}

enum ClosurePeriodStatus {
  OPEN
  RECONCILING
  CLOSED
  REOPENED
}

model FinancialInstitution {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  name           String
  code           String?
  createdById    String        @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccounts   BankAccount[]

  @@unique([organizationId, name])
  @@map("financial_institutions")
}

model Supplier {
  id                   String                  @id @default(cuid())
  organizationId       String                  @map("organization_id")
  name                 String
  legalName            String?                 @map("legal_name")
  taxId                String?                 @map("tax_id")
  personType           PartyType               @default(LEGAL_ENTITY) @map("person_type")
  email                String?
  phone                String?
  bankData             Json?                   @map("bank_data")
  status               PartyStatus             @default(ACTIVE)
  createdById          String                  @map("created_by_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payableAccounts      PayableAccount[]
  qualifications       SupplierQualification[]
  quotationInvitations QuotationInvitation[]
  proposals            SupplierProposal[]
  purchaseOrders       PurchaseOrder[]
  contracts            OperationalContract[]
  brokerProfile        BrokerProfile?
  salesLeads           SalesLead[]
  salesProposals       SalesProposal[]
  sales                Sale[]
  salesCommissions     SalesCommission[]

  @@unique([organizationId, taxId])
  @@index([organizationId, status])
  @@map("suppliers")
}

model Customer {
  id                 String              @id @default(cuid())
  organizationId     String              @map("organization_id")
  name               String
  personType         PartyType           @default(INDIVIDUAL) @map("person_type")
  taxId              String?             @map("tax_id")
  email              String?
  phone              String?
  status             PartyStatus         @default(ACTIVE)
  createdById        String              @map("created_by_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receivableAccounts ReceivableAccount[]
  salesProposals     SalesProposal[]
  salesReservations  SalesReservation[]
  saleParties        SaleParty[]
  postSaleRequests   PostSaleRequest[]

  @@unique([organizationId, taxId])
  @@index([organizationId, status])
  @@map("customers")
}

model BankAccount {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  companyId      String                 @map("company_id")
  projectId      String?                @map("project_id")
  institutionId  String?                @map("institution_id")
  agency         String
  accountNumber  String                 @map("account_number")
  holderName     String                 @map("holder_name")
  type           BankAccountType        @default(OPERATIONAL)
  restriction    BankAccountRestriction @default(FREE)
  currency       String                 @default("BRL") @db.Char(3)
  openingBalance Decimal                @default(0) @map("opening_balance") @db.Decimal(20, 2)
  externalId     String?                @map("external_id")
  status         BankAccountStatus      @default(ACTIVE)
  createdById    String                 @map("created_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project            Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  institution        FinancialInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  payablePayments    PayablePayment[]
  receivablePayments ReceivablePayment[]
  transactions       BankTransaction[]
  transfersOut       FinancialTransfer[]   @relation("TransferFromAccount")
  transfersIn        FinancialTransfer[]   @relation("TransferToAccount")

  @@unique([companyId, agency, accountNumber])
  @@index([organizationId, status])
  @@index([projectId])
  @@map("bank_accounts")
}

model FinancialObligation {
  id                 String           @id @default(cuid())
  organizationId     String           @map("organization_id")
  companyId          String?          @map("company_id")
  projectId          String           @map("project_id")
  costCenterId       String?          @map("cost_center_id")
  economicItemId     String?          @map("economic_item_id")
  budgetLineItemId   String?          @map("budget_line_item_id")
  scheduleActivityId String?          @map("schedule_activity_id")
  nature             ObligationNature
  origin             ObligationOrigin @default(MANUAL)
  documentRef        String?          @map("document_ref")
  description        String
  competenceDate     DateTime         @map("competence_date") @db.Date
  dueDate            DateTime         @map("due_date") @db.Date
  amount             Decimal          @db.Decimal(20, 2)
  responsibleId      String?          @map("responsible_id")
  status             ObligationStatus @default(PENDING)
  createdById        String           @map("created_by_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  cancelledAt        DateTime?        @map("cancelled_at")
  cancelledReason    String?          @map("cancelled_reason")

  organization                Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                     Company?                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project                     Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  costCenter                  CostCenter?                @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  economicItem                EconomicItem?              @relation(fields: [economicItemId], references: [id], onDelete: SetNull)
  budgetLineItem              BudgetLineItem?            @relation(fields: [budgetLineItemId], references: [id], onDelete: SetNull)
  scheduleActivity            ScheduleActivity?          @relation(fields: [scheduleActivityId], references: [id], onDelete: SetNull)
  payableAccount              PayableAccount?
  receivableAccount           ReceivableAccount?
  procurementIntegrationEvent FinancialIntegrationEvent?

  @@index([organizationId, status])
  @@index([projectId, nature])
  @@index([dueDate])
  @@map("financial_obligations")
}

model PayableAccount {
  id                        String           @id @default(cuid())
  organizationId            String           @map("organization_id")
  companyId                 String?          @map("company_id")
  projectId                 String           @map("project_id")
  costCenterId              String?          @map("cost_center_id")
  economicItemId            String?          @map("economic_item_id")
  budgetLineItemId          String?          @map("budget_line_item_id")
  scheduleActivityId        String?          @map("schedule_activity_id")
  obligationId              String?          @unique @map("obligation_id")
  supplierId                String?          @map("supplier_id")
  correctionRuleId          String?          @map("correction_rule_id")
  intercompanyTransactionId String?          @unique @map("intercompany_transaction_id")
  documentNumber            String?          @map("document_number")
  description               String
  origin                    ObligationOrigin @default(MANUAL)
  competenceMonth           DateTime         @map("competence_month") @db.Date
  originalAmount            Decimal          @map("original_amount") @db.Decimal(20, 2)
  responsibleId             String?          @map("responsible_id")
  notes                     String?
  createdById               String           @map("created_by_id")
  approvedById              String?          @map("approved_by_id")
  approvedAt                DateTime?        @map("approved_at")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")
  cancelledAt               DateTime?        @map("cancelled_at")
  cancelledReason           String?          @map("cancelled_reason")

  organization                Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                     Company?                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project                     Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  costCenter                  CostCenter?                @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  economicItem                EconomicItem?              @relation(fields: [economicItemId], references: [id], onDelete: SetNull)
  budgetLineItem              BudgetLineItem?            @relation(fields: [budgetLineItemId], references: [id], onDelete: SetNull)
  scheduleActivity            ScheduleActivity?          @relation(fields: [scheduleActivityId], references: [id], onDelete: SetNull)
  obligation                  FinancialObligation?       @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  supplier                    Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  correctionRule              CorrectionRule?            @relation(fields: [correctionRuleId], references: [id], onDelete: SetNull)
  intercompanyTransaction     IntercompanyTransaction?   @relation("IntercompanyPayable", fields: [intercompanyTransactionId], references: [id], onDelete: SetNull)
  installments                PayableInstallment[]
  procurementIntegrationEvent FinancialIntegrationEvent?

  @@index([organizationId, projectId])
  @@index([supplierId])
  @@index([costCenterId])
  @@map("payable_accounts")
}

model PayableInstallment {
  id                String                   @id @default(cuid())
  payableAccountId  String                   @map("payable_account_id")
  number            Int
  dueDate           DateTime                 @map("due_date") @db.Date
  originalAmount    Decimal                  @map("original_amount") @db.Decimal(20, 2)
  currentAmount     Decimal                  @map("current_amount") @db.Decimal(20, 2)
  discountAmount    Decimal                  @default(0) @map("discount_amount") @db.Decimal(20, 2)
  interestAmount    Decimal                  @default(0) @map("interest_amount") @db.Decimal(20, 2)
  fineAmount        Decimal                  @default(0) @map("fine_amount") @db.Decimal(20, 2)
  withholdingAmount Decimal                  @default(0) @map("withholding_amount") @db.Decimal(20, 2)
  status            PayableInstallmentStatus @default(PREVISTA)
  scheduledDate     DateTime?                @map("scheduled_date") @db.Date
  approvedById      String?                  @map("approved_by_id")
  approvedAt        DateTime?                @map("approved_at")
  cancelledAt       DateTime?                @map("cancelled_at")
  cancelledReason   String?                  @map("cancelled_reason")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  payableAccount PayableAccount          @relation(fields: [payableAccountId], references: [id], onDelete: Cascade)
  payments       PayablePayment[]
  adjustments    InstallmentAdjustment[]

  @@unique([payableAccountId, number])
  @@index([dueDate, status])
  @@map("payable_installments")
}

model PayablePayment {
  id              String             @id @default(cuid())
  installmentId   String             @map("installment_id")
  bankAccountId   String             @map("bank_account_id")
  amount          Decimal            @db.Decimal(20, 2)
  method          PaymentMethod      @default(TRANSFER)
  referenceNumber String?            @map("reference_number")
  paidAt          DateTime           @map("paid_at")
  status          PaymentEventStatus @default(PENDING)
  externalId      String?            @map("external_id")
  idempotencyKey  String?            @unique @map("idempotency_key")
  approvedById    String?            @map("approved_by_id")
  createdById     String             @map("created_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  reversedAt      DateTime?          @map("reversed_at")
  reversalReason  String?            @map("reversal_reason")

  installment         PayableInstallment   @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  bankAccount         BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  reconciliationMatch ReconciliationMatch?

  @@index([installmentId])
  @@index([bankAccountId, paidAt])
  @@map("payable_payments")
}

model ReceivableAccount {
