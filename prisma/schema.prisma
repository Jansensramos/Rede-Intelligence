// ============================================================================
// FASE 9B — FINANCEIRO, TESOURARIA, CONTAS A PAGAR/RECEBER E FLUXO OPERACIONAL
// ============================================================================
// Cadeia: Base Aprovada -> Orçamento Oficial -> Cronograma -> Obrigação
//   -> Conta a Pagar/Receber -> Parcela -> Pagamento/Recebimento
//   -> Transação Bancária -> Conciliação -> Realizado -> Projeção Atualizada
//
// costCenterId/economicItemId/budgetLineItemId/scheduleActivityId são
// referências reais (FK) para permitir drill-down e evitar dupla contagem
// entre previsão (Fase 9A) e compromisso concreto (Fase 9B).

enum PartyStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DISPUTED
}

enum PartyType {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum BankAccountType {
  OPERATIONAL
  COLLECTIONS
  PAYMENTS
  FUNDING
  LINKED
  ESCROW
  RESERVE
  INVESTMENT
  OTHER
}

enum BankAccountRestriction {
  FREE
  RESTRICTED
}

enum BankAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum ObligationNature {
  PAYABLE
  RECEIVABLE
}

enum ObligationOrigin {
  MANUAL
  BUDGET
  CONTRACT
  MEASUREMENT
  PURCHASE
  SALE
  TAX
  FUNDING
  LEGAL
  INTERCOMPANY
  INTEGRATION
  OTHER
}

enum ObligationStatus {
  PENDING
  CONVERTED
  CANCELLED
}

enum PayableInstallmentStatus {
  PREVISTA
  PROGRAMADA
  AGUARDANDO_APROVACAO
  APROVADA
  PARCIALMENTE_PAGA
  PAGA
  CANCELADA
}

enum ReceivableInstallmentStatus {
  PREVISTA
  EMITIDA
  PARCIALMENTE_RECEBIDA
  RECEBIDA
  RENEGOCIADA
  CANCELADA
}

enum PaymentMethod {
  TRANSFER
  BOLETO
  CHEQUE
  CASH
  CARD
  PIX
  OTHER
}

enum PaymentEventStatus {
  PENDING
  PROCESSED
  CLEARED
  FAILED
  REVERSED
}

enum BankTransactionDirection {
  DEBIT
  CREDIT
}

enum BankTransactionOrigin {
  MANUAL
  IMPORT_OFX
  IMPORT_CSV
  API
}

enum BankTransactionStatus {
  RECEIVED
  CANDIDATE
  RECONCILED
  MANUAL_REVIEW
  UNRECONCILED
  DISPUTED
}

enum ReconciliationMatchType {
  PAYABLE_PAYMENT
  RECEIVABLE_PAYMENT
  INTERCOMPANY
  ADJUSTMENT
}

enum ReconciliationConfidence {
  ALTA
  MEDIA
  BAIXA
}

enum ReconciliationStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum IntercompanyNature {
  APORTE
  MUTUO
  ADIANTAMENTO
  RATEIO
  REEMBOLSO
  TRANSFERENCIA
  OUTRA
}

enum IntercompanyStatus {
  PENDING
  APPROVED
  RECORDED
  CONSOLIDATED
  CANCELLED
}

enum FinancialIndexName {
  IPCA
  INCC
  IGP_M
  CUSTOM
}

enum FinancialIndexSource {
  IBGE
  FIPE
  MANUAL
  EXTERNAL_API
}

enum FinancialIndexReliability {
  CONFIRMED
  PROJECTED
  ESTIMATED
}

enum ClosurePeriodStatus {
  OPEN
  RECONCILING
  CLOSED
  REOPENED
}

model FinancialInstitution {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  name           String
  code           String?
  createdById    String        @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccounts   BankAccount[]

  @@unique([organizationId, name])
  @@map("financial_institutions")
}

model Supplier {
  id                   String                  @id @default(cuid())
  organizationId       String                  @map("organization_id")
  name                 String
  legalName            String?                 @map("legal_name")
  taxId                String?                 @map("tax_id")
  personType           PartyType               @default(LEGAL_ENTITY) @map("person_type")
  email                String?
  phone                String?
  bankData             Json?                   @map("bank_data")
  status               PartyStatus             @default(ACTIVE)
  createdById          String                  @map("created_by_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payableAccounts      PayableAccount[]
  qualifications       SupplierQualification[]
  quotationInvitations QuotationInvitation[]
  proposals            SupplierProposal[]
  purchaseOrders       PurchaseOrder[]
  contracts            OperationalContract[]
  brokerProfile        BrokerProfile?
  salesLeads           SalesLead[]
  salesProposals       SalesProposal[]
  sales                Sale[]
  salesCommissions     SalesCommission[]

  @@unique([organizationId, taxId])
  @@index([organizationId, status])
  @@map("suppliers")
}

model Customer {
  id                        String                     @id @default(cuid())
  organizationId            String                     @map("organization_id")
  name                      String
  personType                PartyType                  @default(INDIVIDUAL) @map("person_type")
  taxId                     String?                    @map("tax_id")
  email                     String?
  phone                     String?
