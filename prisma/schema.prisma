model Organization {
  id               String                    @id @default(cuid())
  name             String
  slug             String                    @unique
  legalName        String?                   @map("legal_name")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  memberships      OrganizationMembership[]
  sessions         Session[]
  projects         Project[]
  runs             CalculationRun[]
  policies         InvestmentPolicy[]
  auditLogs        AuditLog[]
  redTeamRuns      RedTeamRun[]
  landAssets       LandAsset[]
  landStudies      LandStudy[]
  landAuditLogs    LandAuditLog[]
  investmentCases  InvestmentCase[]
  investmentBrands OrganizationBrandConfig[]
  designPackages   DesignProjectPackage[]
  designRuleSets   DesignRuleSet[]
  bimModels        BimModel[]
  budgets          Budget[]

  @@map("organizations")
}

model User {
  id                     String                       @id @default(cuid())
  email                  String                       @unique
  name                   String
  passwordHash           String                       @map("password_hash")
  isActive               Boolean                      @default(true) @map("is_active")
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  memberships            OrganizationMembership[]     @relation("MembershipUser")
  membershipsInvited     OrganizationMembership[]     @relation("MembershipInvitedBy")
  sessions               Session[]
  projectsCreated        Project[]                    @relation("ProjectCreatedBy")
  projectsUpdated        Project[]                    @relation("ProjectUpdatedBy")
  studiesCreated         ViabilityStudy[]             @relation("StudyCreatedBy")
  studiesUpdated         ViabilityStudy[]             @relation("StudyUpdatedBy")
  versionsCreated        StudyVersion[]               @relation("VersionCreatedBy")
  versionsUpdated        StudyVersion[]               @relation("VersionUpdatedBy")
  assumptionsCreated     AssumptionSnapshot[]         @relation("AssumptionCreatedBy")
  assumptionsUpdated     AssumptionSnapshot[]         @relation("AssumptionUpdatedBy")
  scenariosCreated       Scenario[]                   @relation("ScenarioCreatedBy")
  scenariosUpdated       Scenario[]                   @relation("ScenarioUpdatedBy")
  calculationRuns        CalculationRun[]
  findingsCreated        RiskFinding[]
  recommendationsCreated Recommendation[]
  sensitivityRuns        SensitivityAnalysis[]
  redTeamRuns            RedTeamRun[]
  scoresCreated          Score[]
  actualEntries          ActualEntry[]
  aiRuns                 AIAnalysisRun[]
  policiesCreated        InvestmentPolicy[]           @relation("PolicyCreatedBy")
  policiesUpdated        InvestmentPolicy[]           @relation("PolicyUpdatedBy")
  assumptionEntries      AssumptionEntry[]
  scenarioOverrides      ScenarioAssumptionOverride[]
  auditLogs              AuditLog[]
  landAssetsCreated      LandAsset[]                  @relation("LandAssetCreatedBy")
  landAssetsUpdated      LandAsset[]                  @relation("LandAssetUpdatedBy")
  landStudiesCreated     LandStudy[]                  @relation("LandStudyCreatedBy")
  landStudiesUpdated     LandStudy[]                  @relation("LandStudyUpdatedBy")
  landVersionsCreated    LandStudyVersion[]           @relation("LandVersionCreatedBy")
  landDocumentsCreated   LandDocument[]
  landAuditLogs          LandAuditLog[]
  budgetsCreated         Budget[]                     @relation("BudgetCreatedBy")
  budgetsUpdated         Budget[]                     @relation("BudgetUpdatedBy")
  budgetsApproved        Budget[]                     @relation("BudgetApprovedBy")

  @@map("users")
}

model OrganizationMembership {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  role           MembershipRole
  invitedById    String?        @map("invited_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?          @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Session {
  id             String       @id @default(cuid())
  tokenHash      String       @unique @map("token_hash")
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  expiresAt      DateTime     @map("expires_at")
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([organizationId, expiresAt])
  @@map("sessions")
}

model InvestmentPolicy {
  id                   String         @id @default(cuid())
  organizationId       String         @map("organization_id")
  name                 String
  version              Int
  isActive             Boolean        @default(true) @map("is_active")
  minimumMarginRate    Decimal?       @map("minimum_margin_rate") @db.Decimal(9, 6)
  minimumRoiRate       Decimal?       @map("minimum_roi_rate") @db.Decimal(9, 6)
  minimumIrrRate       Decimal?       @map("minimum_irr_rate") @db.Decimal(9, 6)
  maximumExposure      Decimal?       @map("maximum_exposure") @db.Decimal(20, 2)
  maximumPaybackMonths Int?           @map("maximum_payback_months")
  minimumPreSalesRate  Decimal?       @map("minimum_pre_sales_rate") @db.Decimal(9, 6)
  createdById          String         @map("created_by_id")
  updatedById          String         @map("updated_by_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy            User           @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User           @relation("PolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  studyVersions        StudyVersion[]

  @@unique([organizationId, name, version])
  @@index([organizationId, isActive])
  @@map("investment_policies")
}

model Project {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  name           String
  city           String
  state          String                 @db.Char(2)
  address        String?
  currency       String                 @default("BRL") @db.Char(3)
  status         ProjectStatus          @default(DRAFT)
  createdById    String                 @map("created_by_id")
  updatedById    String                 @map("updated_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User                   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User                   @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  studies        ViabilityStudy[]
  runs           CalculationRun[]
  actualEntries  ActualEntry[]
  auditLogs      AuditLog[]
  landAssets     LandAsset[]
  designPackages DesignProjectPackage[]
  bimModels      BimModel[]
  budgets        Budget[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("projects")
}

model Budget {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  projectId      String        @map("project_id")
  studyVersionId String?       @map("study_version_id")
  name           String
  description    String?
  status         BudgetStatus  @default(DRAFT)
  currency       String        @default("BRL") @db.Char(3)
  baseDate       DateTime      @map("base_date") @db.Date
  version        Int           @default(1)
  totalBudget    Decimal       @default(0) @map("total_budget") @db.Decimal(20, 2)
  createdById    String        @map("created_by_id")
  updatedById    String        @map("updated_by_id")
  approvedById   String?       @map("approved_by_id")
  approvedAt     DateTime?     @map("approved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  studyVersion   StudyVersion? @relation(fields: [studyVersionId], references: [id], onDelete: Restrict)
  createdBy      User          @relation("BudgetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User          @relation("BudgetUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  approvedBy     User?         @relation("BudgetApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  lineItems      BudgetLineItem[]

  @@unique([projectId, name, version])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([studyVersionId])
  @@map("budgets")
}

model BudgetLineItem {
  id          String           @id @default(cuid())
  budgetId    String           @map("budget_id")
  parentId    String?          @map("parent_id")
  code        String?
  description String
  category    String
  phase       String
  unit        String
  quantity    Decimal          @db.Decimal(18, 4)
  unitCost    Decimal          @map("unit_cost") @db.Decimal(20, 2)
  totalCost   Decimal          @map("total_cost") @db.Decimal(20, 2)
  sortOrder   Int              @default(0) @map("sort_order")
  costCenter  String?          @map("cost_center")
  tower       String?
  origin      String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  budget      Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  parent      BudgetLineItem?  @relation("BudgetItemHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    BudgetLineItem[] @relation("BudgetItemHierarchy")

  @@unique([budgetId, code])
  @@index([budgetId, phase, sortOrder])
  @@index([parentId])
  @@map("budget_line_items")
}

model ViabilityStudy {
  id                   String           @id @default(cuid())
  projectId            String           @map("project_id")
  name                 String
  status               StudyStatus      @default(ACTIVE)
  currentVersionNumber Int              @default(0) @map("current_version_number")
  createdById          String           @map("created_by_id")
  updatedById          String           @map("updated_by_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy            User             @relation("StudyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User             @relation("StudyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  versions             StudyVersion[]
  runs                 CalculationRun[]
  auditLogs            AuditLog[]

  @@unique([projectId, name])
  @@index([projectId, status])
  @@map("viability_studies")
}

model StudyVersion {
  id            String                @id @default(cuid())
  studyId       String                @map("study_id")
  versionNumber Int                   @map("version_number")
  status        StudyVersionStatus    @default(DRAFT)
  label         String?
  notes         String?
  inputHash     String                @map("input_hash")
  engineVersion String                @map("engine_version")
  policyId      String?               @map("policy_id")
  createdById   String                @map("created_by_id")
  updatedById   String                @map("updated_by_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  lockedAt      DateTime?             @map("locked_at")
  study         ViabilityStudy        @relation(fields: [studyId], references: [id], onDelete: Restrict)
  createdBy     User                  @relation("VersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User                  @relation("VersionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  policy        InvestmentPolicy?     @relation(fields: [policyId], references: [id], onDelete: Restrict)
  assumptions   AssumptionSnapshot?
  scenarios     Scenario[]
  runs          CalculationRun[]
  sensitivity   SensitivityAnalysis[]
  redTeamRuns   RedTeamRun[]
  scores        Score[]
  aiRuns        AIAnalysisRun[]
  budgets       Budget[]

  @@unique([studyId, versionNumber])
  @@index([studyId, createdAt])
  @@map("study_versions")
}

model AssumptionSnapshot {
  id                      String            @id @default(cuid())
  studyVersionId          String            @unique @map("study_version_id")
  projectName             String            @map("project_name")
  city                    String
  state                   String            @db.Char(2)
  landAreaM2              Decimal           @map("land_area_m2") @db.Decimal(18, 4)
  units                   Int
  privateAreaPerUnitM2    Decimal           @map("private_area_per_unit_m2") @db.Decimal(18, 4)
