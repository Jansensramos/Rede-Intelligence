  @@unique([benchmarkRunId, memberId])
  @@map("benchmark_outliers")
}

model ForecastEvaluation {
  id                 String               @id @default(cuid())
  organizationId     String               @map("organization_id")
  projectId          String               @map("project_id")
  metricDefinitionId String               @map("metric_definition_id")
  forecastSourceType String               @map("forecast_source_type")
  forecastSourceId   String               @map("forecast_source_id")
  forecastVersion    Int                  @map("forecast_version")
  predictedValue     Decimal              @map("predicted_value") @db.Decimal(20, 6)
  predictedAsOfDate  DateTime             @map("predicted_as_of_date") @db.Date
  horizonStage       ForecastHorizonStage @map("horizon_stage")
