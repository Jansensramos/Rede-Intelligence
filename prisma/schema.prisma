  sampleSize         Int                  @map("sample_size")
  eligibleCount      Int                  @map("eligible_count")
  median             Decimal?             @db.Decimal(20, 6)
  mean               Decimal?             @db.Decimal(20, 6)
  p25                Decimal?             @db.Decimal(20, 6)
  p75                Decimal?             @db.Decimal(20, 6)
  stdDev             Decimal?             @map("std_dev") @db.Decimal(20, 6)
  unit               String
  confidenceLevel    ConfidenceLevel      @map("confidence_level")
  confidenceScore    Float                @map("confidence_score")
  confidenceFactors  Json                 @map("confidence_factors")
  checksum           String
  engineVersion      String               @map("engine_version")
  calculatedAt       DateTime             @default(now()) @map("calculated_at")
