  sessions                   Session[]
  projects                   Project[]
  runs                       CalculationRun[]
  policies                   InvestmentPolicy[]
  auditLogs                  AuditLog[]
  redTeamRuns                RedTeamRun[]
  landAssets                 LandAsset[]
  landStudies                LandStudy[]
  landAuditLogs              LandAuditLog[]
  investmentCases            InvestmentCase[]
  investmentBrands           OrganizationBrandConfig[]
  designPackages             DesignProjectPackage[]
  designRuleSets             DesignRuleSet[]
  bimModels                  BimModel[]
  budgets                    Budget[]
  economicGroups             EconomicGroup[]
  companies                  Company[]
  operationalBaselines       OperationalBaseline[]
  costCenters                CostCenter[]
  economicItems              EconomicItem[]
  schedules                  OperationalSchedule[]
  materialityPolicies        MaterialityPolicy[]
  financialInstitutions      FinancialInstitution[]
  suppliers                  Supplier[]
  customers                  Customer[]
  bankAccounts               BankAccount[]
  financialObligations       FinancialObligation[]
  payableAccounts            PayableAccount[]
  receivableAccounts         ReceivableAccount[]
  bankTransactions           BankTransaction[]
  financialTransfers         FinancialTransfer[]
  intercompanyTransactions   IntercompanyTransaction[]
  financialIndexes           FinancialIndex[]
  correctionRules            CorrectionRule[]
  financialPeriodClosures    FinancialPeriodClosure[]
  supplierQualifications     SupplierQualification[]
  procurementNeeds           ProcurementNeed[]
  purchaseRequisitions       PurchaseRequisition[]
  quotationProcesses         QuotationProcess[]
  approvalPolicies           ApprovalPolicy[]
  approvalRequests           ApprovalRequest[]
  purchaseOrders             PurchaseOrder[]
  operationalContracts       OperationalContract[]
  measurementCertificates    MeasurementCertificate[]
  financialIntegrationEvents FinancialIntegrationEvent[]
  procurementDocumentLinks   ProcurementDocumentLink[]
  legalDueDiligenceCases     LegalDueDiligenceCase[]
  legalAssetRegistrations    LegalAssetRegistration[]
  municipalPropertyRecords   MunicipalPropertyRecord[]
  legalObligations           LegalObligation[]
  legalDeadlinePolicies      LegalDeadlinePolicy[]
  legalAlerts                LegalAlert[]
  legalLicenses              LegalLicense[]
  legalAuthorityProcesses    LegalAuthorityProcess[]
  legalTimelineEvents        LegalTimelineEvent[]
