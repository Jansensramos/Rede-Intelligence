// ============================================================================
// FASE 9I — REDE Data: contratos analíticos, fatos, métricas, benchmark,
// previsto x realizado, forecast accuracy, qualidade, portfólio e Auto Budget
// ============================================================================
//
// Princípio: esta camada NUNCA é segunda fonte de verdade. AnalyticsFact
// aponta de volta ao registro operacional original por sourceEntityType/
// sourceEntityId (lineage leve, sem FK rígida entre domínios transacionais —
// evita acoplar 9I a uma dezena de tabelas 9A-9H) mais sourceModule/
// sourceVersion para idempotência e proveniência. FKs reais só existem para
// as dimensões conformadas já compartilhadas (Organization, Project,
// EconomicItem, CostCenter, ProjectOperatingUnit) e para as entidades da
// própria 9I. Reprocessamento cria nova versão/registro, nunca sobrescreve
// fato ou métrica antiga (idempotência garantida por @@unique em
// (organizationId, factType, sourceEntityType, sourceEntityId)).

enum MetricStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum MetricAggregation {
  SUM
  AVERAGE
  RATIO
  MEDIAN
  PERCENTILE
  LAST
}

enum AnalyticsFactType {
  COST
  PROCUREMENT_PRICE
  MEASUREMENT
  FINANCIAL_SETTLEMENT
  SALES
  SCHEDULE_PROGRESS
  PRICE_OBSERVATION
  FORECAST
  PRODUCTIVITY
  LEGAL_CYCLE
  ACCOUNTING
}

enum EconomicStage {
  ESTIMATED
  BUDGETED
  QUOTED
  CONTRACTED
  MEASURED
  ACCRUED
  ACCOUNTED
  PAID
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum OutlierDecision {
  PENDING
  VALID
  ERROR
  EXTRAORDINARY
  DIFFERENT_SCOPE
  EXCLUDED
}

enum ForecastHorizonStage {
  LAND
  APPROVAL
  CONSTRUCTION_START
  CONSTRUCTION_MID
  CONSTRUCTION_LATE
  DELIVERED
}

enum ForecastBias {
  OPTIMISTIC
  PESSIMISTIC
  NEUTRAL
}

enum DataQualityDimension {
  COMPLETENESS
  CONSISTENCY
  VALIDITY
  UNIQUENESS
  FRESHNESS
  PROVENANCE
}

enum DataQualitySeverity {
  INFO
  WARNING
  CRITICAL
}

enum DataQualityIssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  WONT_FIX
}

enum AutoBudgetProposalStatus {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

enum PortfolioScopeType {
  GROUP
  COMPANY
  PROJECT
}

enum BenchmarkSubjectType {
  ECONOMIC_ITEM
  PROJECT
  SUPPLIER
  SCHEDULE_ACTIVITY
}

enum AnalyticsRefreshStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum DatasetClassification {
  PUBLIC_INTERNAL
  CONFIDENTIAL
  RESTRICTED_PII
}

enum NormalizationMethod {
  NOMINAL
  CORRECTED
}

model AnalyticsDataContract {
  id                String       @id @default(cuid())
  organizationId    String       @map("organization_id")
  key               String
  version           Int
  name              String
  sourceModule      String       @map("source_module")
  sourceEntities    Json         @map("source_entities")
  grain             String
  dimensions        Json
  measureDefinition Json         @map("measure_definition")
  temporality       String
  ownerId           String       @map("owner_id")
  status            MetricStatus @default(DRAFT)
  effectiveFrom     DateTime     @map("effective_from") @db.Date
  deprecatedAt      DateTime?    @map("deprecated_at")
  checksum          String
  createdById       String       @map("created_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facts             AnalyticsFact[]
  metricDefinitions MetricDefinition[]

  @@unique([organizationId, key, version])
  @@index([organizationId, status])
  @@map("analytics_data_contracts")
}

model MetricDefinition {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  contractId     String?           @map("contract_id")
  key            String
  name           String
  version        Int               @default(1)
  definition     String            @db.Text
  formula        String            @db.Text
  engineVersion  String            @map("engine_version")
  unit           String
  aggregation    MetricAggregation
  grain          String
  dimensions     Json
  numerator      String?
  denominator    String?
  ownerId        String            @map("owner_id")
  status         MetricStatus      @default(DRAFT)
  effectiveFrom  DateTime          @map("effective_from") @db.Date
  deprecatedAt   DateTime?         @map("deprecated_at")
  supersedesId   String?           @map("supersedes_id")
  createdById    String            @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contract            AnalyticsDataContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  supersedes          MetricDefinition?      @relation("MetricVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy        MetricDefinition[]     @relation("MetricVersions")
  runs                MetricRun[]
  benchmarkRuns       BenchmarkRun[]
  forecastEvaluations ForecastEvaluation[]

  @@unique([organizationId, key, version])
  @@index([organizationId, status])
  @@map("metric_definitions")
}

model MetricRun {
  id                 String    @id @default(cuid())
  organizationId     String    @map("organization_id")
  metricDefinitionId String    @map("metric_definition_id")
  projectId          String?   @map("project_id")
  scopeType          String    @map("scope_type")
  scopeId            String    @map("scope_id")
