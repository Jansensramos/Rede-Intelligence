  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receivableAccounts        ReceivableAccount[]
  salesProposals            SalesProposal[]
  salesReservations         SalesReservation[]
  saleParties               SaleParty[]
  postSaleRequests          PostSaleRequest[]
  signatureParties          SignatureParty[]
  creditBureauConsultations CreditBureauConsultation[]

  @@unique([organizationId, taxId])
  @@index([organizationId, status])
  @@map("customers")
}

model BankAccount {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  companyId      String                 @map("company_id")
  projectId      String?                @map("project_id")
  institutionId  String?                @map("institution_id")
  agency         String
  accountNumber  String                 @map("account_number")
  holderName     String                 @map("holder_name")
  type           BankAccountType        @default(OPERATIONAL)
  restriction    BankAccountRestriction @default(FREE)
  currency       String                 @default("BRL") @db.Char(3)
  openingBalance Decimal                @default(0) @map("opening_balance") @db.Decimal(20, 2)
  externalId     String?                @map("external_id")
  status         BankAccountStatus      @default(ACTIVE)
  createdById    String                 @map("created_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project            Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  institution        FinancialInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  payablePayments    PayablePayment[]
  receivablePayments ReceivablePayment[]
  transactions       BankTransaction[]
  transfersOut       FinancialTransfer[]   @relation("TransferFromAccount")
  transfersIn        FinancialTransfer[]   @relation("TransferToAccount")

  @@unique([companyId, agency, accountNumber])
  @@index([organizationId, status])
  @@index([projectId])
  @@map("bank_accounts")
}

model FinancialObligation {
  id                 String           @id @default(cuid())
  organizationId     String           @map("organization_id")
  companyId          String?          @map("company_id")
  projectId          String           @map("project_id")
  costCenterId       String?          @map("cost_center_id")
  economicItemId     String?          @map("economic_item_id")
  budgetLineItemId   String?          @map("budget_line_item_id")
  scheduleActivityId String?          @map("schedule_activity_id")
