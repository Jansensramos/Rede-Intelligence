  RECEIVED_AMOUNT
}

enum SalesCommissionTrigger {
  SIGNATURE
  DOWN_PAYMENT_PAID
  RECEIPT
  MILESTONE
  OTHER
}

enum SalesCommissionStatus {
  PENDING
  APPROVED
  PAYABLE_GENERATED
  PAID
  CANCELLED
}

enum SalesInspectionOutcome {
  ACCEPTED
  ACCEPTED_WITH_PENDING
  REJECTED
}

enum PostSaleCategory {
  GARANTIA
  ASSISTENCIA
  OCORRENCIA
  OUTRO
