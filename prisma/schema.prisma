  periodStart        DateTime? @map("period_start") @db.Date
  periodEnd          DateTime? @map("period_end") @db.Date
  value              Decimal   @db.Decimal(20, 6)
  unit               String
  dimensions         Json
  inputRefs          Json      @map("input_refs")
  engineVersion      String    @map("engine_version")
  checksum           String
  calculatedAt       DateTime  @default(now()) @map("calculated_at")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  metricDefinition MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metricDefinitionId, scopeType, scopeId, asOfDate])
  @@index([organizationId, scopeType, scopeId])
  @@map("metric_runs")
}

