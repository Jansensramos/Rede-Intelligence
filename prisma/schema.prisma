model ScheduleDependency {
  id            String                 @id @default(cuid())
  predecessorId String                 @map("predecessor_id")
  successorId   String                 @map("successor_id")
  type          ScheduleDependencyType @default(FINISH_TO_START)
  lagDays       Int                    @default(0) @map("lag_days")
  predecessor   ScheduleActivity       @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     ScheduleActivity       @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([successorId])
  @@map("schedule_dependencies")
}

model ScheduleAllocation {
  id                  String           @id @default(cuid())
  activityId          String           @map("activity_id")
  periodStart         DateTime         @map("period_start") @db.Date
  physicalPercent     Decimal          @map("physical_percent") @db.Decimal(9, 6)
  financialPercent    Decimal          @map("financial_percent") @db.Decimal(9, 6)
  plannedDisbursement Decimal          @map("planned_disbursement") @db.Decimal(20, 2)
  notes               String?
  activity            ScheduleActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, periodStart])
  @@index([periodStart])
  @@map("schedule_allocations")
}

model OperationalForecast {
  id              String                    @id @default(cuid())
  projectId       String                    @map("project_id")
  baselineId      String                    @map("baseline_id")
  scheduleId      String?                   @map("schedule_id")
  version         Int
  status          OperationalForecastStatus @default(STRUCTURED)
  assumptions     Json
  projectedResult Json?                     @map("projected_result")
  createdById     String                    @map("created_by_id")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  baseline        OperationalBaseline       @relation(fields: [baselineId], references: [id], onDelete: Restrict)
  schedule        OperationalSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@unique([projectId, version])
  @@map("operational_forecasts")
}

model ViabilityStudy {
  id                   String           @id @default(cuid())
  projectId            String           @map("project_id")
  name                 String
  status               StudyStatus      @default(ACTIVE)
  currentVersionNumber Int              @default(0) @map("current_version_number")
  createdById          String           @map("created_by_id")
  updatedById          String           @map("updated_by_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy            User             @relation("StudyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User             @relation("StudyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  versions             StudyVersion[]
  runs                 CalculationRun[]
  auditLogs            AuditLog[]

  @@unique([projectId, name])
  @@index([projectId, status])
  @@map("viability_studies")
}

model StudyVersion {
  id                   String                @id @default(cuid())
  studyId              String                @map("study_id")
  versionNumber        Int                   @map("version_number")
  status               StudyVersionStatus    @default(DRAFT)
  label                String?
  notes                String?
  inputHash            String                @map("input_hash")
  engineVersion        String                @map("engine_version")
  policyId             String?               @map("policy_id")
  createdById          String                @map("created_by_id")
  updatedById          String                @map("updated_by_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  lockedAt             DateTime?             @map("locked_at")
  study                ViabilityStudy        @relation(fields: [studyId], references: [id], onDelete: Restrict)
  createdBy            User                  @relation("VersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User                  @relation("VersionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  policy               InvestmentPolicy?     @relation(fields: [policyId], references: [id], onDelete: Restrict)
  assumptions          AssumptionSnapshot?
  scenarios            Scenario[]
  runs                 CalculationRun[]
  sensitivity          SensitivityAnalysis[]
  redTeamRuns          RedTeamRun[]
  scores               Score[]
  aiRuns               AIAnalysisRun[]
  budgets              Budget[]
  operationalBaselines OperationalBaseline[]

  @@unique([studyId, versionNumber])
  @@index([studyId, createdAt])
  @@map("study_versions")
}

model AssumptionSnapshot {
  id                      String            @id @default(cuid())
  studyVersionId          String            @unique @map("study_version_id")
  projectName             String            @map("project_name")
  city                    String
  state                   String            @db.Char(2)
  landAreaM2              Decimal           @map("land_area_m2") @db.Decimal(18, 4)
  units                   Int
  privateAreaPerUnitM2    Decimal           @map("private_area_per_unit_m2") @db.Decimal(18, 4)
  grossBuiltAreaM2        Decimal?          @map("gross_built_area_m2") @db.Decimal(18, 4)
  efficiencyRate          Decimal           @map("efficiency_rate") @db.Decimal(9, 6)
  unitPrice               Decimal           @map("unit_price") @db.Decimal(20, 2)
  landPrice               Decimal           @map("land_price") @db.Decimal(20, 2)
  constructionCostPerM2   Decimal           @map("construction_cost_per_m2") @db.Decimal(20, 2)
  indirectCostsRate       Decimal           @map("indirect_costs_rate") @db.Decimal(9, 6)
  contingencyRate         Decimal           @map("contingency_rate") @db.Decimal(9, 6)
  taxRate                 Decimal           @map("tax_rate") @db.Decimal(9, 6)
  commissionRate          Decimal           @map("commission_rate") @db.Decimal(9, 6)
  marketingRate           Decimal           @map("marketing_rate") @db.Decimal(9, 6)
  approvalMonths          Int               @map("approval_months")
  constructionMonths      Int               @map("construction_months")
  salesVelocityUnitsMonth Decimal           @map("sales_velocity_units_month") @db.Decimal(12, 4)
  salesStartDelayMonths   Int               @default(0) @map("sales_start_delay_months")
  downPaymentRate         Decimal           @map("down_payment_rate") @db.Decimal(9, 6)
  duringConstructionRate  Decimal           @map("during_construction_rate") @db.Decimal(9, 6)
  onDeliveryRate          Decimal           @map("on_delivery_rate") @db.Decimal(9, 6)
  financingLimit          Decimal           @map("financing_limit") @db.Decimal(20, 2)
  annualFinancingRate     Decimal           @map("annual_financing_rate") @db.Decimal(9, 6)
  annualDiscountRate      Decimal           @map("annual_discount_rate") @db.Decimal(9, 6)
  minimumMarginRate       Decimal           @map("minimum_margin_rate") @db.Decimal(9, 6)
  minimumRoiRate          Decimal           @map("minimum_roi_rate") @db.Decimal(9, 6)
  minimumIrrRate          Decimal           @map("minimum_irr_rate") @db.Decimal(9, 6)
  maximumExposure         Decimal           @map("maximum_exposure") @db.Decimal(20, 2)
  minimumContingencyRate  Decimal           @map("minimum_contingency_rate") @db.Decimal(9, 6)
  createdById             String            @map("created_by_id")
  updatedById             String            @map("updated_by_id")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  studyVersion            StudyVersion      @relation(fields: [studyVersionId], references: [id], onDelete: Restrict)
  createdBy               User              @relation("AssumptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy               User              @relation("AssumptionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  entries                 AssumptionEntry[]

  @@map("assumption_snapshots")
}

model AssumptionEntry {
  id                   String             @id @default(cuid())
  assumptionSnapshotId String             @map("assumption_snapshot_id")
  key                  String
  category             AssumptionCategory
  value                Json
  unit                 String
  source               String?
  notes                String?
  createdById          String             @map("created_by_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  assumptionSnapshot   AssumptionSnapshot @relation(fields: [assumptionSnapshotId], references: [id], onDelete: Restrict)
  createdBy            User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([assumptionSnapshotId, key])
  @@index([category, key])
  @@map("assumption_entries")
}

model Scenario {
  id              String                       @id @default(cuid())
  studyVersionId  String                       @map("study_version_id")
  name            String
  kind            ScenarioKind
  description     String
  adjustments     Json
  createdById     String                       @map("created_by_id")
  updatedById     String                       @map("updated_by_id")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  studyVersion    StudyVersion                 @relation(fields: [studyVersionId], references: [id], onDelete: Restrict)
  createdBy       User                         @relation("ScenarioCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User                         @relation("ScenarioUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  runs            CalculationRun[]
  overrides       ScenarioAssumptionOverride[]
  findings        RiskFinding[]
  sensitivityBase SensitivityAnalysis[]
  scores          Score[]
  redTeamRuns     RedTeamRun[]

  @@unique([studyVersionId, name])
  @@index([studyVersionId, kind])
  @@map("scenarios")
}

model ScenarioAssumptionOverride {
  id            String   @id @default(cuid())
  scenarioId    String   @map("scenario_id")
  assumptionKey String   @map("assumption_key")
  value         Json
  unit          String
  source        String?
  notes         String?
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  scenario      Scenario @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([scenarioId, assumptionKey])
  @@map("scenario_assumption_overrides")
}

model CalculationRun {
  id              String             @id @default(cuid())
  organizationId  String             @map("organization_id")
  projectId       String             @map("project_id")
  studyId         String             @map("study_id")
  studyVersionId  String             @map("study_version_id")
  scenarioId      String             @map("scenario_id")
  engineVersion   String             @map("engine_version")
  inputHash       String             @map("input_hash")
  calculatedAt    DateTime           @default(now()) @map("calculated_at")
  createdById     String             @map("created_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  study           ViabilityStudy     @relation(fields: [studyId], references: [id], onDelete: Restrict)
  studyVersion    StudyVersion       @relation(fields: [studyVersionId], references: [id], onDelete: Restrict)
  scenario        Scenario           @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  createdBy       User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  cashFlow        CashFlowEntry[]
  result          FinancialResult?
  traces          CalculationTrace[]
  findings        RiskFinding[]
  recommendations Recommendation[]
  metrics         CalculatedMetric[]

  @@unique([studyVersionId, scenarioId, engineVersion])
  @@index([organizationId, calculatedAt])
  @@index([projectId, studyId])
  @@map("calculation_runs")
}

model CashFlowEntry {
  id                    String         @id @default(cuid())
  calculationRunId      String         @map("calculation_run_id")
  month                 Int
  phase                 String
  unitsSold             Decimal        @map("units_sold") @db.Decimal(12, 4)
  salesValue            Decimal        @map("sales_value") @db.Decimal(20, 8)
  receipts              Decimal        @db.Decimal(20, 8)
  landCost              Decimal        @map("land_cost") @db.Decimal(20, 8)
  constructionCost      Decimal        @map("construction_cost") @db.Decimal(20, 8)
  indirectCosts         Decimal        @map("indirect_costs") @db.Decimal(20, 8)
  contingency           Decimal        @db.Decimal(20, 8)
  marketing             Decimal        @db.Decimal(20, 8)
  commission            Decimal        @db.Decimal(20, 8)
  taxes                 Decimal        @db.Decimal(20, 8)
  operatingNet          Decimal        @map("operating_net") @db.Decimal(20, 8)
  interest              Decimal        @db.Decimal(20, 8)
  financingDraw         Decimal        @map("financing_draw") @db.Decimal(20, 8)
  financingRepayment    Decimal        @map("financing_repayment") @db.Decimal(20, 8)
  equityFlow            Decimal        @map("equity_flow") @db.Decimal(20, 8)
  cumulativeProjectCash Decimal        @map("cumulative_project_cash") @db.Decimal(20, 8)
  cumulativeEquityCash  Decimal        @map("cumulative_equity_cash") @db.Decimal(20, 8)
  outstandingDebt       Decimal        @map("outstanding_debt") @db.Decimal(20, 8)
  createdAt             DateTime       @default(now()) @map("created_at")
  calculationRun        CalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Restrict)

  @@unique([calculationRunId, month])
  @@map("cash_flow_entries")
}

model FinancialResult {
  id                    String         @id @default(cuid())
  calculationRunId      String         @unique @map("calculation_run_id")
  payload               Json
  vgv                   Decimal        @db.Decimal(20, 2)
  netRevenue            Decimal        @map("net_revenue") @db.Decimal(20, 2)
  totalCost             Decimal        @map("total_cost") @db.Decimal(20, 2)
  profit                Decimal        @db.Decimal(20, 2)
  marginOnVgv           Decimal        @map("margin_on_vgv") @db.Decimal(12, 8)
  marginOnNetRevenue    Decimal        @map("margin_on_net_revenue") @db.Decimal(12, 8)
  roi                   Decimal?       @db.Decimal(12, 8)
  annualIrr             Decimal?       @map("annual_irr") @db.Decimal(12, 8)
  npv                   Decimal        @db.Decimal(20, 2)
  paybackMonth          Int?           @map("payback_month")
  maximumCashExposure   Decimal        @map("maximum_cash_exposure") @db.Decimal(20, 2)
  maximumExposureMonth  Int            @map("maximum_exposure_month")
  equityCapitalRequired Decimal        @map("equity_capital_required") @db.Decimal(20, 2)
  fundingNeed           Decimal        @map("funding_need") @db.Decimal(20, 2)
  breakEvenVgv          Decimal        @map("break_even_vgv") @db.Decimal(20, 2)
  breakEvenUnits        Int            @map("break_even_units")
  createdAt             DateTime       @default(now()) @map("created_at")
  calculationRun        CalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Restrict)

  @@map("financial_results")
}

model CalculatedMetric {
  id               String         @id @default(cuid())
  calculationRunId String         @map("calculation_run_id")
  key              String
  value            Json
  unit             String
  category         String
  createdAt        DateTime       @default(now()) @map("created_at")
  calculationRun   CalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Restrict)

  @@unique([calculationRunId, key])
  @@index([key, category])
  @@map("calculated_metrics")
}

model CalculationTrace {
  id               String         @id @default(cuid())
  calculationRunId String         @map("calculation_run_id")
  metric           String
  label            String
  formula          String
  inputs           Json
  result           String
  engineVersion    String         @map("engine_version")
  createdAt        DateTime       @default(now()) @map("created_at")
  calculationRun   CalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Restrict)

  @@index([calculationRunId, metric])
  @@map("calculation_traces")
}

model RiskFinding {
  id               String          @id @default(cuid())
  calculationRunId String          @map("calculation_run_id")
  severity         FindingSeverity
  category         FindingCategory
  title            String
  evidence         String
  action           String
  classification   String
  code             String
  description      String
  metric           String?
  actualValue      Decimal?        @map("actual_value") @db.Decimal(20, 8)
  thresholdValue   Decimal?        @map("threshold_value") @db.Decimal(20, 8)
  scenarioId       String          @map("scenario_id")
  createdById      String          @map("created_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  calculationRun   CalculationRun  @relation(fields: [calculationRunId], references: [id], onDelete: Restrict)
  scenario         Scenario        @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  createdBy        User            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([calculationRunId, severity])
  @@index([scenarioId, code])
  @@map("risk_findings")
}

model Recommendation {
  id               String               @id @default(cuid())
  calculationRunId String               @map("calculation_run_id")
  status           RecommendationStatus
  label            String
  dominantReason   String               @map("dominant_reason")
  createdById      String               @map("created_by_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  calculationRun   CalculationRun       @relation(fields: [calculationRunId], references: [id], onDelete: Restrict)
  createdBy        User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([calculationRunId])
  @@map("recommendations")
}

model SensitivityAnalysis {
  id             String             @id @default(cuid())
  studyVersionId String             @map("study_version_id")
  baseScenarioId String?            @map("base_scenario_id")
  name           String
  engineVersion  String             @map("engine_version")
  configVersion  String             @map("config_version")
  variables      Json
  results        Json
  status         AnalysisRunStatus  @default(PENDING)
  completedAt    DateTime?          @map("completed_at")
  createdById    String             @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  studyVersion   StudyVersion       @relation(fields: [studyVersionId], references: [id], onDelete: Restrict)
  baseScenario   Scenario?          @relation(fields: [baseScenarioId], references: [id], onDelete: Restrict)
  createdBy      User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  cases          SensitivityCase[]
  breakEvens     BreakEvenResult[]
  stressTests    StressTestResult[]

  @@index([studyVersionId, createdAt])
  @@index([baseScenarioId])
  @@map("sensitivity_analyses")
}

model SensitivityCase {
  id                    String              @id @default(cuid())
  sensitivityAnalysisId String              @map("sensitivity_analysis_id")
  variable              String
  label                 String
  variation             Decimal             @db.Decimal(12, 6)
  variationUnit         String              @map("variation_unit")
  baseValue             String              @map("base_value")
  stressedValue         String              @map("stressed_value")
  metrics               Json
  policyViolations      Json                @map("policy_violations")
  score                 Decimal             @db.Decimal(5, 2)
  classification        String
  scoreDelta            Decimal             @map("score_delta") @db.Decimal(5, 2)
  createdAt             DateTime            @default(now()) @map("created_at")
  sensitivityAnalysis   SensitivityAnalysis @relation(fields: [sensitivityAnalysisId], references: [id], onDelete: Cascade)

  @@index([sensitivityAnalysisId, variable])
  @@map("sensitivity_cases")
}

model BreakEvenResult {
  id                    String              @id @default(cuid())
  sensitivityAnalysisId String              @map("sensitivity_analysis_id")
  key                   String
  label                 String
  variable              String
  value                 Decimal             @db.Decimal(18, 8)
  unit                  String
  status                String
  iterations            Int
  createdAt             DateTime            @default(now()) @map("created_at")
  sensitivityAnalysis   SensitivityAnalysis @relation(fields: [sensitivityAnalysisId], references: [id], onDelete: Cascade)

  @@unique([sensitivityAnalysisId, key])
  @@map("break_even_results")
}

model StressTestResult {
  id                    String              @id @default(cuid())
  sensitivityAnalysisId String              @map("sensitivity_analysis_id")
  key                   String
  label                 String
  adjustments           Json
  metrics               Json
  violatedPolicies      Json                @map("violated_policies")
  score                 Decimal             @db.Decimal(5, 2)
  classification        String
  scoreDelta            Decimal             @map("score_delta") @db.Decimal(5, 2)
  recommendationStatus  String              @map("recommendation_status")
  recommendationLabel   String              @map("recommendation_label")
  createdAt             DateTime            @default(now()) @map("created_at")
  sensitivityAnalysis   SensitivityAnalysis @relation(fields: [sensitivityAnalysisId], references: [id], onDelete: Cascade)

  @@unique([sensitivityAnalysisId, key])
  @@map("stress_test_results")
}

model RedTeamRun {
  id                   String                       @id @default(cuid())
  organizationId       String                       @map("organization_id")
  studyVersionId       String                       @map("study_version_id")
  scenarioId           String                       @map("scenario_id")
  agentType            String?                      @map("agent_type")
  modelProvider        String                       @map("provider")
  modelName            String?                      @map("model")
  promptVersion        String                       @map("prompt_version")
  engineVersion        String                       @map("engine_version")
  scoreVersion         String                       @map("score_version")
  redTeamVersion       String                       @map("red_team_version")
  status               AnalysisRunStatus            @default(QUEUED)
  startedAt            DateTime                     @map("started_at")
  finishedAt           DateTime?                    @map("finished_at")
  output               Json
  evidencePack         Json                         @map("evidence_pack")
  conclusion           Json
  calls                Int                          @default(0)
  durationMs           Int                          @default(0) @map("duration_ms")
  inputTokens          Int?                         @map("input_tokens")
  outputTokens         Int?                         @map("output_tokens")
  retries              Int                          @default(0)
  error                String?
  createdById          String                       @map("created_by_id")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studyVersion         StudyVersion                 @relation(fields: [studyVersionId], references: [id], onDelete: Restrict)
  scenario             Scenario                     @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  createdBy            User                         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  agents               RedTeamAgentResult[]
  evidenceItems        RedTeamEvidenceItem[]
  findings             RedTeamFinding[]
  assumptionChallenges RedTeamAssumptionChallenge[]
  evidenceRequests     RedTeamEvidenceRequest[]
  crossReviews         RedTeamCrossReview[]
  disagreements        RedTeamDisagreement[]
  executiveConclusion  RedTeamExecutiveConclusion?

  @@unique([studyVersionId, scenarioId, redTeamVersion])
  @@index([studyVersionId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("red_team_runs")
}

model RedTeamAgentResult {
  id           String            @id @default(cuid())
  runId        String            @map("run_id")
  agent        RedTeamAgentType
  label        String
  status       String
  confidence   RedTeamConfidence
  opinion      String
  questions    Json
  providerUsed Boolean           @default(false) @map("provider_used")
  createdAt    DateTime          @default(now()) @map("created_at")
  run          RedTeamRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, agent])
  @@map("red_team_agent_results")
}

model RedTeamEvidenceItem {
  id           String                   @id @default(cuid())
  runId        String                   @map("run_id")
  ref          String
  kind         String
  label        String
  value        Json
  source       String
  trust        String
  createdAt    DateTime                 @default(now()) @map("created_at")
  run          RedTeamRun               @relation(fields: [runId], references: [id], onDelete: Cascade)
  findingLinks RedTeamFindingEvidence[]

  @@unique([runId, ref])
  @@index([runId, kind])
  @@map("red_team_evidence_items")
}

model RedTeamFinding {
  id                String                   @id @default(cuid())
  runId             String                   @map("run_id")
  code              String
  agent             RedTeamAgentType
  category          String
  type              RedTeamFindingType
  severity          RedTeamFindingSeverity
  confidence        RedTeamConfidence
  title             String
  description       String
  implication       String
  recommendedAction String                   @map("recommended_action")
  status            RedTeamFindingStatus     @default(OPEN)
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  run               RedTeamRun               @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidenceLinks     RedTeamFindingEvidence[]
  evidenceRequests  RedTeamEvidenceRequest[]
  crossReviews      RedTeamCrossReview[]
  disagreementsA    RedTeamDisagreement[]    @relation("DisagreementFindingA")
  disagreementsB    RedTeamDisagreement[]    @relation("DisagreementFindingB")

  @@unique([runId, code])
  @@index([runId, severity, status])
  @@map("red_team_findings")
}

model RedTeamFindingEvidence {
  id             String              @id @default(cuid())
  findingId      String              @map("finding_id")
  evidenceItemId String              @map("evidence_item_id")
  evidenceRef    String              @map("evidence_ref")
