  documentRef        String?          @map("document_ref")
  description        String
  competenceDate     DateTime         @map("competence_date") @db.Date
  dueDate            DateTime         @map("due_date") @db.Date
  amount             Decimal          @db.Decimal(20, 2)
  responsibleId      String?          @map("responsible_id")
  status             ObligationStatus @default(PENDING)
  createdById        String           @map("created_by_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  cancelledAt        DateTime?        @map("cancelled_at")
  cancelledReason    String?          @map("cancelled_reason")

  organization                Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                     Company?                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project                     Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  costCenter                  CostCenter?                @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  economicItem                EconomicItem?              @relation(fields: [economicItemId], references: [id], onDelete: SetNull)
  budgetLineItem              BudgetLineItem?            @relation(fields: [budgetLineItemId], references: [id], onDelete: SetNull)
  scheduleActivity            ScheduleActivity?          @relation(fields: [scheduleActivityId], references: [id], onDelete: SetNull)
  payableAccount              PayableAccount?
  receivableAccount           ReceivableAccount?
  procurementIntegrationEvent FinancialIntegrationEvent?

  @@index([organizationId, status])
  @@index([projectId, nature])
  @@index([dueDate])
