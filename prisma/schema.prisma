  economicItemId            String?          @map("economic_item_id")
  obligationId              String?          @unique @map("obligation_id")
  customerId                String?          @map("customer_id")
  correctionRuleId          String?          @map("correction_rule_id")
  intercompanyTransactionId String?          @unique @map("intercompany_transaction_id")
  saleId                    String?          @map("sale_id")
  unitReference             String?          @map("unit_reference")
  contractReference         String?          @map("contract_reference")
  documentNumber            String?          @map("document_number")
  description               String
  origin                    ObligationOrigin @default(MANUAL)
  competenceMonth           DateTime         @map("competence_month") @db.Date
  originalAmount            Decimal          @map("original_amount") @db.Decimal(20, 2)
  responsibleId             String?          @map("responsible_id")
  notes                     String?
  createdById               String           @map("created_by_id")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")
  cancelledAt               DateTime?        @map("cancelled_at")
  cancelledReason           String?          @map("cancelled_reason")

  organization            Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                 Company?                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project                 Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  costCenter              CostCenter?                @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  economicItem            EconomicItem?              @relation(fields: [economicItemId], references: [id], onDelete: SetNull)
  obligation              FinancialObligation?       @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  customer                Customer?                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  correctionRule          CorrectionRule?            @relation(fields: [correctionRuleId], references: [id], onDelete: SetNull)
  intercompanyTransaction IntercompanyTransaction?   @relation("IntercompanyReceivable", fields: [intercompanyTransactionId], references: [id], onDelete: SetNull)
  sale                    Sale?                      @relation(fields: [saleId], references: [id], onDelete: SetNull)
  installments            ReceivableInstallment[]
  salesIntegrationEvent   FinancialIntegrationEvent?

  @@index([organizationId, projectId])
  @@index([customerId])
  @@index([saleId])
  @@map("receivable_accounts")
}

model ReceivableInstallment {
  id                  String                      @id @default(cuid())
  receivableAccountId String                      @map("receivable_account_id")
  number              Int
  dueDate             DateTime                    @map("due_date") @db.Date
  originalAmount      Decimal                     @map("original_amount") @db.Decimal(20, 2)
  currentAmount       Decimal                     @map("current_amount") @db.Decimal(20, 2)
  discountAmount      Decimal                     @default(0) @map("discount_amount") @db.Decimal(20, 2)
  interestAmount      Decimal                     @default(0) @map("interest_amount") @db.Decimal(20, 2)
  fineAmount          Decimal                     @default(0) @map("fine_amount") @db.Decimal(20, 2)
  status              ReceivableInstallmentStatus @default(PREVISTA)
  issuedAt            DateTime?                   @map("issued_at")
  renegotiatedFromId  String?                     @unique @map("renegotiated_from_id")
  cancelledAt         DateTime?                   @map("cancelled_at")
  cancelledReason     String?                     @map("cancelled_reason")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  receivableAccount ReceivableAccount            @relation(fields: [receivableAccountId], references: [id], onDelete: Cascade)
  renegotiatedFrom  ReceivableInstallment?       @relation("InstallmentRenegotiation", fields: [renegotiatedFromId], references: [id], onDelete: Restrict)
  renegotiatedTo    ReceivableInstallment?       @relation("InstallmentRenegotiation")
  payments          ReceivablePayment[]
  adjustments       InstallmentAdjustment[]
  salesInstallment  SalesPaymentPlanInstallment?

  @@unique([receivableAccountId, number])
  @@index([dueDate, status])
  @@map("receivable_installments")
}

model ReceivablePayment {
  id              String             @id @default(cuid())
  installmentId   String             @map("installment_id")
  bankAccountId   String             @map("bank_account_id")
  amount          Decimal            @db.Decimal(20, 2)
  method          PaymentMethod      @default(PIX)
  referenceNumber String?            @map("reference_number")
  receivedAt      DateTime           @map("received_at")
  status          PaymentEventStatus @default(PENDING)
  externalId      String?            @map("external_id")
  idempotencyKey  String?            @unique @map("idempotency_key")
  createdById     String             @map("created_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  reversedAt      DateTime?          @map("reversed_at")
  reversalReason  String?            @map("reversal_reason")

  installment         ReceivableInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  bankAccount         BankAccount           @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  reconciliationMatch ReconciliationMatch?

  @@index([installmentId])
  @@index([bankAccountId, receivedAt])
  @@map("receivable_payments")
}

model BankTransaction {
  id             String                   @id @default(cuid())
  organizationId String                   @map("organization_id")
  bankAccountId  String                   @map("bank_account_id")
  occurredAt     DateTime                 @map("occurred_at") @db.Date
  competenceDate DateTime?                @map("competence_date") @db.Date
  amount         Decimal                  @db.Decimal(20, 2)
  direction      BankTransactionDirection
  description    String
  counterparty   String?
  documentRef    String?                  @map("document_ref")
  origin         BankTransactionOrigin    @default(MANUAL)
  externalId     String?                  @map("external_id")
  importBatchId  String?                  @map("import_batch_id")
  checksum       String
  status         BankTransactionStatus    @default(RECEIVED)
  reconciledAt   DateTime?                @map("reconciled_at")
  reconciledById String?                  @map("reconciled_by_id")
  createdAt      DateTime                 @default(now()) @map("created_at")

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccount           BankAccount           @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  reconciliationMatches ReconciliationMatch[]
  transferAsFrom        FinancialTransfer?    @relation("TransferFromTransaction")
  transferAsTo          FinancialTransfer?    @relation("TransferToTransaction")

  @@unique([bankAccountId, checksum])
  @@index([organizationId, status])
  @@index([bankAccountId, occurredAt])
  @@map("bank_transactions")
}

model ReconciliationMatch {
  id                        String                   @id @default(cuid())
  bankTransactionId         String                   @map("bank_transaction_id")
  matchType                 ReconciliationMatchType  @map("match_type")
  payablePaymentId          String?                  @unique @map("payable_payment_id")
  receivablePaymentId       String?                  @unique @map("receivable_payment_id")
  intercompanyTransactionId String?                  @map("intercompany_transaction_id")
  confidence                ReconciliationConfidence
  score                     Int
  criteria                  Json
  status                    ReconciliationStatus     @default(SUGGESTED)
  matchedById               String?                  @map("matched_by_id")
  matchedAt                 DateTime?                @map("matched_at")
  rejectedReason            String?                  @map("rejected_reason")
  createdAt                 DateTime                 @default(now()) @map("created_at")

  bankTransaction         BankTransaction          @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  payablePayment          PayablePayment?          @relation(fields: [payablePaymentId], references: [id], onDelete: SetNull)
  receivablePayment       ReceivablePayment?       @relation(fields: [receivablePaymentId], references: [id], onDelete: SetNull)
  intercompanyTransaction IntercompanyTransaction? @relation(fields: [intercompanyTransactionId], references: [id], onDelete: SetNull)

  @@index([bankTransactionId, status])
  @@map("reconciliation_matches")
}

model FinancialTransfer {
  id                String         @id @default(cuid())
  organizationId    String         @map("organization_id")
  fromBankAccountId String         @map("from_bank_account_id")
  toBankAccountId   String         @map("to_bank_account_id")
  amount            Decimal        @db.Decimal(20, 2)
  transferredAt     DateTime       @map("transferred_at")
  description       String?
  status            TransferStatus @default(PENDING)
  fromTransactionId String?        @unique @map("from_transaction_id")
  toTransactionId   String?        @unique @map("to_transaction_id")
  createdById       String         @map("created_by_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fromBankAccount BankAccount      @relation("TransferFromAccount", fields: [fromBankAccountId], references: [id], onDelete: Restrict)
  toBankAccount   BankAccount      @relation("TransferToAccount", fields: [toBankAccountId], references: [id], onDelete: Restrict)
  fromTransaction BankTransaction? @relation("TransferFromTransaction", fields: [fromTransactionId], references: [id], onDelete: SetNull)
  toTransaction   BankTransaction? @relation("TransferToTransaction", fields: [toTransactionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("financial_transfers")
}

model IntercompanyTransaction {
  id              String             @id @default(cuid())
  organizationId  String             @map("organization_id")
  economicGroupId String?            @map("economic_group_id")
  fromCompanyId   String             @map("from_company_id")
  toCompanyId     String             @map("to_company_id")
  fromProjectId   String?            @map("from_project_id")
  toProjectId     String?            @map("to_project_id")
  amount          Decimal            @db.Decimal(20, 2)
  occurredAt      DateTime           @map("occurred_at") @db.Date
  nature          IntercompanyNature @default(APORTE)
  referenceNumber String?            @map("reference_number")
  description     String?
  status          IntercompanyStatus @default(PENDING)
  createdById     String             @map("created_by_id")
  approvedById    String?            @map("approved_by_id")
  approvedAt      DateTime?          @map("approved_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  economicGroup         EconomicGroup?        @relation(fields: [economicGroupId], references: [id], onDelete: SetNull)
  fromCompany           Company               @relation("IntercompanyFrom", fields: [fromCompanyId], references: [id], onDelete: Restrict)
  toCompany             Company               @relation("IntercompanyTo", fields: [toCompanyId], references: [id], onDelete: Restrict)
  fromProject           Project?              @relation("IntercompanyFromProject", fields: [fromProjectId], references: [id], onDelete: SetNull)
  toProject             Project?              @relation("IntercompanyToProject", fields: [toProjectId], references: [id], onDelete: SetNull)
  payableAccount        PayableAccount?       @relation("IntercompanyPayable")
  receivableAccount     ReceivableAccount?    @relation("IntercompanyReceivable")
  reconciliationMatches ReconciliationMatch[]

  @@index([organizationId, status])
  @@map("intercompany_transactions")
}

model FinancialIndex {
  id             String                    @id @default(cuid())
  organizationId String                    @map("organization_id")
  name           FinancialIndexName
  referenceDate  DateTime                  @map("reference_date") @db.Date
  value          Decimal                   @db.Decimal(14, 8)
  source         FinancialIndexSource      @default(MANUAL)
  reliability    FinancialIndexReliability @default(ESTIMATED)
  notes          String?
  createdById    String                    @map("created_by_id")
  createdAt      DateTime                  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name, referenceDate])
  @@index([organizationId, name])
  @@map("financial_indexes")
}

model CorrectionRule {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  name           String
  indexName      FinancialIndexName @map("index_name")
  periodicity    String             @default("MONTHLY")
  lagMonths      Int                @default(0) @map("lag_months")
  interestRate   Decimal?           @map("interest_rate") @db.Decimal(9, 6)
  fineRate       Decimal?           @map("fine_rate") @db.Decimal(9, 6)
  discountRule   Json?              @map("discount_rule")
  formula        String?
  version        Int                @default(1)
  isActive       Boolean            @default(true) @map("is_active")
  createdById    String             @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization                 Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payableAccounts              PayableAccount[]
  receivableAccounts           ReceivableAccount[]
  operationalContracts         OperationalContract[]
  salesPaymentPlanInstallments SalesPaymentPlanInstallment[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("correction_rules")
}

model InstallmentAdjustment {
  id                      String              @id @default(cuid())
  payableInstallmentId    String?             @map("payable_installment_id")
  receivableInstallmentId String?             @map("receivable_installment_id")
  previousAmount          Decimal             @map("previous_amount") @db.Decimal(20, 2)
  resultingAmount         Decimal             @map("resulting_amount") @db.Decimal(20, 2)
  indexName               FinancialIndexName? @map("index_name")
  indexPercentageApplied  Decimal?            @map("index_percentage_applied") @db.Decimal(9, 6)
  interestAmount          Decimal             @default(0) @map("interest_amount") @db.Decimal(20, 2)
  fineAmount              Decimal             @default(0) @map("fine_amount") @db.Decimal(20, 2)
  discountAmount          Decimal             @default(0) @map("discount_amount") @db.Decimal(20, 2)
  referencePeriod         String              @map("reference_period")
  appliedById             String              @map("applied_by_id")
  appliedAt               DateTime            @default(now()) @map("applied_at")

  payableInstallment    PayableInstallment?    @relation(fields: [payableInstallmentId], references: [id], onDelete: Cascade)
  receivableInstallment ReceivableInstallment? @relation(fields: [receivableInstallmentId], references: [id], onDelete: Cascade)

  @@index([payableInstallmentId])
  @@index([receivableInstallmentId])
  @@map("installment_adjustments")
}

model FinancialPeriodClosure {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  companyId      String              @map("company_id")
  referenceMonth DateTime            @map("reference_month") @db.Date
  status         ClosurePeriodStatus @default(OPEN)
  pendingIssues  Json?               @map("pending_issues")
  closedById     String?             @map("closed_by_id")
  closedAt       DateTime?           @map("closed_at")
  reopenedById   String?             @map("reopened_by_id")
  reopenedAt     DateTime?           @map("reopened_at")
  reopenReason   String?             @map("reopen_reason")
  createdById    String              @map("created_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([organizationId, companyId, referenceMonth])
  @@index([organizationId, status])
  @@map("financial_period_closures")
}

