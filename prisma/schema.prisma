  responsibleId String              @map("responsible_id")
  evidence      Json?
  satisfiedAt   DateTime?           @map("satisfied_at")
  createdById   String              @map("created_by_id")
  updatedById   String              @map("updated_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  contract      OperationalContract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([contractId, code])
  @@index([contractId, status, dueAt])
  @@map("legal_contract_conditions")
}

model LegalGuarantee {
  id             String              @id @default(cuid())
  contractId     String              @map("contract_id")
  code           String
  type           String
  issuer         String
  beneficiary    String
  amount         Decimal?            @db.Decimal(20, 2)
  startsAt       DateTime?           @map("starts_at") @db.Date
  expiresAt      DateTime?           @map("expires_at") @db.Date
  status         LegalItemStatus
  documentLinkId String?             @map("document_link_id")
  createdById    String              @map("created_by_id")
  updatedById    String              @map("updated_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  contract       OperationalContract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([contractId, code])
  @@index([contractId, status, expiresAt])
  @@map("legal_guarantees")
}

model LegalFinancialEvent {
  id                    String                    @id @default(cuid())
  organizationId        String                    @map("organization_id")
  projectId             String                    @map("project_id")
  legalObligationId     String                    @map("legal_obligation_id")
  financialObligationId String?                   @map("financial_obligation_id")
  payableAccountId      String?                   @map("payable_account_id")
  eventType             String                    @map("event_type")
  sourceVersion         Int                       @default(1) @map("source_version")
  idempotencyKey        String                    @unique @map("idempotency_key")
  payloadChecksum       String                    @map("payload_checksum")
  payload               Json
  status                LegalFinancialEventStatus @default(PENDING)
  processedAt           DateTime?                 @map("processed_at")
  reversedAt            DateTime?                 @map("reversed_at")
  lastError             String?                   @map("last_error") @db.Text
  createdById           String                    @map("created_by_id")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project               Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  legalObligation       LegalObligation           @relation(fields: [legalObligationId], references: [id], onDelete: Restrict)

  @@unique([legalObligationId, eventType, sourceVersion])
  @@index([organizationId, projectId, status])
  @@map("legal_financial_events")
}

// ============================================================================
// FASE 9E — VENDAS, CLIENTES, UNIDADES, CONTRATOS DE VENDA, RECEBÍVEIS E PÓS-VENDA
// ============================================================================
// Cadeia: Unidade (estoque) -> Tabela de Preços -> Cliente -> Proposta -> Reserva
//   -> Venda -> Contrato de Venda -> Plano de Pagamento comercial
//   -> createExternalReceivableObligation (9E->9B, idempotente, espelha 9C->9B)
//   -> ReceivableAccount/Installment (9B, cobrança/recebimento/conciliação já existentes)
//   -> Renegociação / Distrato -> Entrega -> Vistoria -> Pós-venda.
// Customer/Supplier (9B) e ApprovalPolicy/Request/DecisionRecord/ProcurementDocumentLink (9C)
// são reutilizados integralmente — nenhuma tabela paralela de cliente, corretor,
// alçada ou documento é criada nesta fase.

enum SalesUnitStatus {
  DISPONIVEL
  EM_RESERVA
  RESERVADA
  EM_PROPOSTA
  VENDIDA
  BLOQUEADA
  PERMUTA
  DISTRATADA
  ENTREGUE
}

enum SalesBlockOrigin {
  PERMUTA
  JURIDICO
  DIRETORIA
  INCORPORACAO
  COMERCIAL
  TECNICA
  OUTRO
}

enum SalesPriceTableStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  EXPIRED
}

enum SalesLeadStage {
  NOVO
  EM_ATENDIMENTO
  PROPOSTA
  PERDIDO
  CONVERTIDO
}

enum SalesProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum SalesReservationStatus {
  ACTIVE
  CONFIRMED
  EXPIRED
  CANCELLED
  CONVERTED
}

enum SaleStatus {
  DRAFT
  UNDER_APPROVAL
  APPROVED
  CANCELLED
}

enum SalePartyRole {
  BUYER
  CO_BUYER
  REPRESENTATIVE
  GUARANTOR
}

enum SalesContractSignatureStatus {
  PENDING
  PARTIALLY_SIGNED
  SIGNED
}

enum SalesContractStatus {
  DRAFT
  ACTIVE
  AMENDED
  RESCINDED
}

enum SalesPaymentPlanStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  CANCELLED
}

enum SalesInstallmentNature {
  DOWN_PAYMENT
  MONTHLY
  INTERMEDIATE
  ANNUAL
  KEYS
  FINANCING
  BALANCE
  REINFORCEMENT
  CUSTOM
}

enum SalesCommissionBasis {
  SOLD_PRICE
  RECEIVED_AMOUNT
}

enum SalesCommissionTrigger {
  SIGNATURE
  DOWN_PAYMENT_PAID
  RECEIPT
  MILESTONE
  OTHER
}

enum SalesCommissionStatus {
  PENDING
  APPROVED
  PAYABLE_GENERATED
  PAID
  CANCELLED
}

enum SalesInspectionOutcome {
  ACCEPTED
  ACCEPTED_WITH_PENDING
  REJECTED
}

enum PostSaleCategory {
  GARANTIA
  ASSISTENCIA
  OCORRENCIA
  OUTRO
}

enum PostSaleStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

model SalesUnit {
  id              String          @id @default(cuid())
  organizationId  String          @map("organization_id")
  projectId       String          @map("project_id")
  companyId       String          @map("company_id")
  operatingUnitId String?         @map("operating_unit_id")
  detectedUnitId  String?         @map("detected_unit_id")
  code            String
  floor           String?
  typology        String
  privateAreaM2   Decimal         @map("private_area_m2") @db.Decimal(12, 4)
  totalAreaM2     Decimal?        @map("total_area_m2") @db.Decimal(12, 4)
  parkingSpaces   Int             @default(0) @map("parking_spaces")
  storageUnits    Int             @default(0) @map("storage_units")
  position        String?
  characteristics Json?
  status          SalesUnitStatus @default(DISPONIVEL)
  createdById     String          @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operatingUnit    ProjectOperatingUnit? @relation(fields: [operatingUnitId], references: [id], onDelete: SetNull)
  blocks           SalesUnitBlock[]
  priceLines       SalesPriceTableLine[]
  proposals        SalesProposal[]
  reservations     SalesReservation[]
  sales            Sale[]
  inspections      SalesUnitInspection[]
  postSaleRequests PostSaleRequest[]

  @@unique([projectId, code])
  @@index([organizationId, status])
  @@index([operatingUnitId])
  @@map("sales_units")
}

model SalesUnitBlock {
  id            String           @id @default(cuid())
  salesUnitId   String           @map("sales_unit_id")
  origin        SalesBlockOrigin
  responsibleId String           @map("responsible_id")
  reason        String
  startedAt     DateTime         @default(now()) @map("started_at")
  endedAt       DateTime?        @map("ended_at")
  createdById   String           @map("created_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  salesUnit SalesUnit @relation(fields: [salesUnitId], references: [id], onDelete: Cascade)

  @@index([salesUnitId, endedAt])
  @@map("sales_unit_blocks")
}

model SalesPriceTable {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  projectId      String                @map("project_id")
  companyId      String                @map("company_id")
  version        Int
  validFrom      DateTime              @map("valid_from") @db.Date
  validUntil     DateTime?             @map("valid_until") @db.Date
  responsibleId  String                @map("responsible_id")
  status         SalesPriceTableStatus @default(DRAFT)
  notes          String?
  createdById    String                @map("created_by_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lines        SalesPriceTableLine[]
  proposals    SalesProposal[]
  sales        Sale[]

  @@unique([projectId, version])
  @@index([projectId, status])
  @@map("sales_price_tables")
}

model SalesPriceTableLine {
  id                     String   @id @default(cuid())
  priceTableId           String   @map("price_table_id")
  salesUnitId            String   @map("sales_unit_id")
  listPrice              Decimal  @map("list_price") @db.Decimal(20, 2)
  minimumAuthorizedPrice Decimal? @map("minimum_authorized_price") @db.Decimal(20, 2)

  priceTable SalesPriceTable @relation(fields: [priceTableId], references: [id], onDelete: Cascade)
  salesUnit  SalesUnit       @relation(fields: [salesUnitId], references: [id], onDelete: Restrict)

  @@unique([priceTableId, salesUnitId])
  @@index([salesUnitId])
  @@map("sales_price_table_lines")
}

model SalesLead {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  projectId      String?        @map("project_id")
  name           String
  contact        String
  source         String
  channel        String?
  brokerId       String?        @map("broker_id")
  stage          SalesLeadStage @default(NOVO)
  lostReason     String?        @map("lost_reason")
  customerId     String?        @map("customer_id")
  createdById    String         @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  broker       Supplier?    @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id])

  @@index([organizationId, stage])
  @@map("sales_leads")
}

model BrokerProfile {
  id                    String      @id @default(cuid())
  organizationId        String      @map("organization_id")
  supplierId            String      @unique @map("supplier_id")
  creci                 String?
  parentAgencyId        String?     @map("parent_agency_id")
  defaultCommissionRate Decimal?    @map("default_commission_rate") @db.Decimal(9, 6)
  channel               String?
  status                PartyStatus @default(ACTIVE)
  createdById           String      @map("created_by_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  parentAgency BrokerProfile?  @relation("BrokerAgency", fields: [parentAgencyId], references: [id], onDelete: Restrict)
  brokers      BrokerProfile[] @relation("BrokerAgency")

  @@index([organizationId, status])
  @@map("broker_profiles")
}

model SalesProposal {
  id                      String              @id @default(cuid())
  organizationId          String              @map("organization_id")
  projectId               String              @map("project_id")
  salesUnitId             String              @map("sales_unit_id")
  customerId              String              @map("customer_id")
  brokerId                String?             @map("broker_id")
  priceTableId            String              @map("price_table_id")
  proposedPrice           Decimal             @map("proposed_price") @db.Decimal(20, 2)
  discountAmount          Decimal             @default(0) @map("discount_amount") @db.Decimal(20, 2)
  paymentConditionSummary Json                @map("payment_condition_summary")
  validUntil              DateTime            @map("valid_until")
  status                  SalesProposalStatus @default(DRAFT)
  approvalRequestId       String?             @map("approval_request_id")
  createdById             String              @map("created_by_id")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project                   Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  salesUnit                 SalesUnit                  @relation(fields: [salesUnitId], references: [id], onDelete: Restrict)
  customer                  Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  broker                    Supplier?                  @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  priceTable                SalesPriceTable            @relation(fields: [priceTableId], references: [id], onDelete: Restrict)
  reservations              SalesReservation[]
  sale                      Sale?
  creditBureauConsultations CreditBureauConsultation[]

  @@index([organizationId, status])
  @@index([salesUnitId])
  @@map("sales_proposals")
}

model SalesReservation {
  id              String                 @id @default(cuid())
  organizationId  String                 @map("organization_id")
  projectId       String                 @map("project_id")
  salesUnitId     String                 @map("sales_unit_id")
  customerId      String                 @map("customer_id")
  proposalId      String?                @map("proposal_id")
  startedAt       DateTime               @default(now()) @map("started_at")
  expiresAt       DateTime               @map("expires_at")
  responsibleId   String                 @map("responsible_id")
  condition       Json?
  status          SalesReservationStatus @default(ACTIVE)
  cancelledAt     DateTime?              @map("cancelled_at")
  cancelledReason String?                @map("cancelled_reason")
  createdById     String                 @map("created_by_id")
  createdAt       DateTime               @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  salesUnit    SalesUnit      @relation(fields: [salesUnitId], references: [id], onDelete: Restrict)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  proposal     SalesProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  sale         Sale?

  @@index([organizationId, status])
  @@index([salesUnitId, status])
  @@map("sales_reservations")
}

model Sale {
  id                          String     @id @default(cuid())
  organizationId              String     @map("organization_id")
  projectId                   String     @map("project_id")
  companyId                   String     @map("company_id")
  salesUnitId                 String     @map("sales_unit_id")
  priceTableId                String     @map("price_table_id")
  proposalId                  String?    @unique @map("proposal_id")
  reservationId               String?    @unique @map("reservation_id")
  brokerId                    String?    @map("broker_id")
  soldPrice                   Decimal    @map("sold_price") @db.Decimal(20, 2)
  discountAmount              Decimal    @default(0) @map("discount_amount") @db.Decimal(20, 2)
  incentiveAmount             Decimal    @default(0) @map("incentive_amount") @db.Decimal(20, 2)
  tradeInValue                Decimal?   @map("trade_in_value") @db.Decimal(20, 2)
  commercialConditionSnapshot Json       @map("commercial_condition_snapshot")
  version                     Int        @default(1)
  status                      SaleStatus @default(DRAFT)
  approvalRequestId           String?    @map("approval_request_id")
  approvedById                String?    @map("approved_by_id")
  approvedAt                  DateTime?  @map("approved_at")
  cancelledAt                 DateTime?  @map("cancelled_at")
  cancelledReason             String?    @map("cancelled_reason")
  externalId                  String?    @map("external_id")
  externalSource              String?    @map("external_source")
  createdById                 String     @map("created_by_id")
  createdAt                   DateTime   @default(now()) @map("created_at")
  updatedAt                   DateTime   @updatedAt @map("updated_at")

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  salesUnit          SalesUnit             @relation(fields: [salesUnitId], references: [id], onDelete: Restrict)
  priceTable         SalesPriceTable       @relation(fields: [priceTableId], references: [id], onDelete: Restrict)
  proposal           SalesProposal?        @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  reservation        SalesReservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  broker             Supplier?             @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  parties            SaleParty[]
  contract           SalesContract?
  paymentPlans       SalesPaymentPlan[]
  commissions        SalesCommission[]
  inspections        SalesUnitInspection[]
  postSaleRequests   PostSaleRequest[]
  receivableAccounts ReceivableAccount[]

  @@index([organizationId, status])
  @@index([salesUnitId, status])
  @@map("sales")
}

model SaleParty {
  id                  String        @id @default(cuid())
  saleId              String        @map("sale_id")
  customerId          String        @map("customer_id")
  role                SalePartyRole
  ownershipPercentage Decimal?      @map("ownership_percentage") @db.Decimal(7, 4)

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([saleId, customerId, role])
  @@index([customerId])
  @@map("sale_parties")
}

model SalesContract {
  id                  String                       @id @default(cuid())
  organizationId      String                       @map("organization_id")
  projectId           String                       @map("project_id")
  companyId           String                       @map("company_id")
  saleId              String                       @unique @map("sale_id")
  templateVersionId   String?                      @map("template_version_id")
  number              String
  title               String
  soldPrice           Decimal                      @map("sold_price") @db.Decimal(20, 2)
  commercialCondition Json                         @map("commercial_condition")
  signatureStatus     SalesContractSignatureStatus @default(PENDING) @map("signature_status")
  effectiveFrom       DateTime?                    @map("effective_from")
  status              SalesContractStatus          @default(DRAFT)
  version             Int                          @default(1)
  createdById         String                       @map("created_by_id")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sale              Sale                     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  templateVersion   ContractTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  documents         ContractDocument[]
  signatureRequests SignatureRequest[]

  @@unique([projectId, number])
  @@index([organizationId, status])
  @@index([templateVersionId])
  @@map("sales_contracts")
}

model SalesPaymentPlan {
  id             String                 @id @default(cuid())
  saleId         String                 @map("sale_id")
  version        Int
  status         SalesPaymentPlanStatus @default(DRAFT)
  previousPlanId String?                @unique @map("previous_plan_id")
  createdById    String                 @map("created_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  activatedAt    DateTime?              @map("activated_at")
  supersededAt   DateTime?              @map("superseded_at")

  sale         Sale                          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  previousPlan SalesPaymentPlan?             @relation("PaymentPlanRevisions", fields: [previousPlanId], references: [id], onDelete: Restrict)
  nextPlan     SalesPaymentPlan?             @relation("PaymentPlanRevisions")
  installments SalesPaymentPlanInstallment[]

  @@unique([saleId, version])
  @@index([saleId, status])
  @@map("sales_payment_plans")
}

model SalesPaymentPlanInstallment {
  id                      String                 @id @default(cuid())
  planId                  String                 @map("plan_id")
  number                  Int
  nature                  SalesInstallmentNature
  dueDate                 DateTime               @map("due_date") @db.Date
  amount                  Decimal                @db.Decimal(20, 2)
  correctionRuleId        String?                @map("correction_rule_id")
  receivableInstallmentId String?                @unique @map("receivable_installment_id")
  cancelledAt             DateTime?              @map("cancelled_at")
  cancelledReason         String?                @map("cancelled_reason")
  createdAt               DateTime               @default(now()) @map("created_at")

  plan                  SalesPaymentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  correctionRule        CorrectionRule?        @relation(fields: [correctionRuleId], references: [id], onDelete: SetNull)
  receivableInstallment ReceivableInstallment? @relation(fields: [receivableInstallmentId], references: [id], onDelete: SetNull)

  @@unique([planId, number])
  @@map("sales_payment_plan_installments")
}

model SalesCommissionPolicy {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  projectId      String?                @map("project_id")
  triggerEvent   SalesCommissionTrigger @default(SIGNATURE) @map("trigger_event")
  percentage     Decimal                @db.Decimal(9, 6)
  basis          SalesCommissionBasis   @default(SOLD_PRICE)
  isActive       Boolean                @default(true) @map("is_active")
  createdById    String                 @map("created_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  commissions  SalesCommission[]

  @@index([organizationId, projectId, isActive])
  @@map("sales_commission_policies")
}

model SalesCommission {
  id                String                 @id @default(cuid())
  saleId            String                 @map("sale_id")
  brokerId          String                 @map("broker_id")
  policyId          String?                @map("policy_id")
  basis             SalesCommissionBasis
  percentage        Decimal                @db.Decimal(9, 6)
  amount            Decimal                @db.Decimal(20, 2)
  triggerEvent      SalesCommissionTrigger @map("trigger_event")
  status            SalesCommissionStatus  @default(PENDING)
  approvalRequestId String?                @map("approval_request_id")
  approvedById      String?                @map("approved_by_id")
  approvedAt        DateTime?              @map("approved_at")
  createdById       String                 @map("created_by_id")
  createdAt         DateTime               @default(now()) @map("created_at")

  sale   Sale                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  broker Supplier               @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  policy SalesCommissionPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([brokerId, status])
  @@map("sales_commissions")
}

model SalesUnitInspection {
  id               String                  @id @default(cuid())
  salesUnitId      String                  @map("sales_unit_id")
  saleId           String                  @map("sale_id")
  scheduledAt      DateTime                @map("scheduled_at")
  responsibleId    String                  @map("responsible_id")
  checklist        Json?
  pendingIssues    Json?                   @map("pending_issues")
  outcome          SalesInspectionOutcome?
  nextInspectionAt DateTime?               @map("next_inspection_at")
  createdById      String                  @map("created_by_id")
  createdAt        DateTime                @default(now()) @map("created_at")

  salesUnit SalesUnit @relation(fields: [salesUnitId], references: [id], onDelete: Restrict)
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([salesUnitId, scheduledAt])
  @@map("sales_unit_inspections")
}

model PostSaleRequest {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  salesUnitId    String           @map("sales_unit_id")
  saleId         String           @map("sale_id")
  customerId     String           @map("customer_id")
  category       PostSaleCategory
  description    String
  responsibleId  String?          @map("responsible_id")
  slaDueAt       DateTime?        @map("sla_due_at")
  status         PostSaleStatus   @default(OPEN)
  createdById    String           @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesUnit    SalesUnit        @relation(fields: [salesUnitId], references: [id], onDelete: Restrict)
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  updates      PostSaleUpdate[]

  @@index([organizationId, status])
  @@map("post_sale_requests")
}

model PostSaleUpdate {
  id        String   @id @default(cuid())
  requestId String   @map("request_id")
  authorId  String   @map("author_id")
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  request PostSaleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("post_sale_updates")
}

// -----------------------------------------------------------------------------
// FASE 9K.4 — Fechamento Comercial 360 (Crédito → Proposta → Contrato → Assinatura → Recebíveis)
// Estende a 9E (SalesContract já é a origem econômica oficial — nada aqui duplica preço, parcela
// ou recebível). Bytes de documento NÃO ficam no Postgres — reaproveita o `FileStorageProvider`
// genérico de src/infrastructure/storage/design-file-storage.ts (mesmo shape de
// `DesignFile.storageProvider/storageKey/checksum/fileSize`), com uma segunda instância apontando
// para `.rede-storage/contracts`. Transporte/idempotência de webhook continuam 100% na 9H
// (`ConnectorInstallation` + `IntegrationInboxEvent.@@unique([installationId, provider, eventId])`)
// — `SignatureEvent` é só a projeção de domínio 1:1 opcional de um `IntegrationInboxEvent` já
// processado (ver campo `sourceInboxEventId`), nunca uma segunda infra genérica de webhook.
// -----------------------------------------------------------------------------

enum ContractTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ContractTemplateVersionStatus {
  DRAFT
  APPROVED
}

enum ContractDocumentKind {
  MODEL_RENDER
  ATTACHMENT
  SIGNED_FINAL
}

enum ContractDocumentStatus {
  DRAFT
  FINAL
}

enum SignatureProviderCode {
  MOCK
  CLICKSIGN
  MANUAL_UPLOAD
}

enum SignatureRequestStatus {
  PREPARADO
  ENVIADO
  AGUARDANDO_ASSINATURAS
  ASSINADO
  RECUSADO
  CANCELADO
  ERRO
}

enum SignatoryRole {
  BUYER
  CO_BUYER
  REPRESENTATIVE
  GUARANTOR
  SELLER
  WITNESS
}

enum SignaturePartyStatus {
  PENDING
  SIGNED
  DECLINED
}

/**
 * Só transições de DOMÍNIO (o transporte/recebimento cru do webhook é `IntegrationInboxEvent.status`, 9H — não duplicado aqui).
 */
enum SignatureEventType {
  CREATED
  SENT
  PARTY_SIGNED
  PARTY_DECLINED
  COMPLETED
  CANCELLED
  ERROR
}

enum CreditBureauProviderCode {
  MOCK
  SERASA_EXPERIAN
}

enum CreditConsultationPurpose {
  SALE_PROPOSAL_ANALYSIS
  CONTRACT_RENEWAL
  OTHER
}

enum CreditConsultationStatus {
  REQUESTED
  COMPLETED
  ERROR
}

enum CreditConsultationResult {
  SEM_RESTRICAO
  COM_RESTRICAO
  REQUER_ANALISE
}

/**
 * Modelo contratual por empreendimento (item 1 do plano). Nunca editado após ter uma versão APROVADA — só nova versão via `ContractTemplateVersion`.
 */
model ContractTemplate {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  projectId      String                 @map("project_id")
  name           String
  status         ContractTemplateStatus @default(DRAFT)
  createdById    String                 @map("created_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions     ContractTemplateVersion[]

  @@unique([projectId, name])
  @@index([organizationId, status])
  @@map("contract_templates")
}

/**
 * Versão do modelo (item 1/3/6). `content` é o texto com placeholders — motor de merge simples,
 * sem motor jurídico. `checksum` = hash do `content`, gravado na criação (integridade/conferência,
 * mesmo padrão de `DesignFile.checksum`). Regra de imutabilidade (aplicada em serviço, igual ao
 * resto do arquivo — nenhum trigger de banco): enquanto `status = DRAFT` o serviço pode fazer
 * `UPDATE` no mesmo registro (rascunho em edição); a partir do `UPDATE` que grava `status =
 * APPROVED` (+ `approvedById`/`approvedAt`), o serviço NUNCA mais escreve neste registro — conteúdo
 * novo sempre cria `version + 1`. `@@unique([templateId, version])` impede duas linhas com o mesmo
 * número de versão.
 */
model ContractTemplateVersion {
  id           String                        @id @default(cuid())
  templateId   String                        @map("template_id")
  version      Int
  content      String                        @db.Text
  checksum     String
  variables    Json?
  status       ContractTemplateVersionStatus @default(DRAFT)
  approvedById String?                       @map("approved_by_id")
  approvedAt   DateTime?                     @map("approved_at")
  createdById  String                        @map("created_by_id")
  createdAt    DateTime                      @default(now()) @map("created_at")

  template  ContractTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  contracts SalesContract[]
  documents ContractDocument[]

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("contract_template_versions")
}

/**
 * Documento contratual (item 3/9): render do modelo, anexo comercial ou artefato final assinado —
 * um único shape para os três, distinguido por `kind`. Não reaproveita `ProjectDocument`
 * (acoplado a `InvestmentCase`, domínio de viabilidade/investimento, tenant path incompatível).
 * NÃO guarda bytes no Postgres — `storageProvider` + `storageKey` são a referência opaca ao
 * `FileStorageProvider` já existente (mesmo contrato de `design-file-storage.ts`), lido/escrito
 * via `.put()`/`.read()`; o banco só guarda metadado (nome, mime, tamanho, checksum) + a chave.
 */
model ContractDocument {
  id                String                 @id @default(cuid())
  organizationId    String                 @map("organization_id")
  contractId        String                 @map("contract_id")
  templateVersionId String?                @map("template_version_id")
  kind              ContractDocumentKind
  status            ContractDocumentStatus @default(DRAFT)
  version           Int                    @default(1)
  title             String
  fileName          String                 @map("file_name")
  mimeType          String                 @map("mime_type")
  storageProvider   String                 @map("storage_provider")
  storageKey        String                 @map("storage_key")
  fileSize          Int                    @map("file_size")
  checksum          String
  createdById       String                 @map("created_by_id")
  createdAt         DateTime               @default(now()) @map("created_at")

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contract          SalesContract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  templateVersion   ContractTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  signatureRequests SignatureRequest[]       @relation("SignatureSourceDocument")
  finalDocumentFor  SignatureRequest?        @relation("SignatureFinalDocument")

  @@unique([contractId, kind, version])
  @@index([contractId, kind])
  @@map("contract_documents")
}

/**
 * Abstração `SignatureProvider` (item 4) — domínio nunca acopla a Clicksign: `provider` +
 * `externalId` opaco. `documentId` aponta para o `ContractDocument` (kind=MODEL_RENDER)
 * efetivamente enviado; `finalDocumentId` só é preenchido em ASSINADO, apontando para o artefato
 * final (kind=SIGNED_FINAL) — RESTRICT (item 8: evidência histórica crítica, nunca apagável em
 * silêncio enquanto referenciada). `@@unique([organizationId, provider, externalId])` (item 2):
 * `externalId` só é único DENTRO da conta daquele provider/tenant, nunca globalmente.
 */
model SignatureRequest {
  id               String                 @id @default(cuid())
  organizationId   String                 @map("organization_id")
  projectId        String                 @map("project_id")
  contractId       String                 @map("contract_id")
  documentId       String                 @map("document_id")
  provider         SignatureProviderCode  @default(MOCK)
  externalId       String?                @map("external_id")
  status           SignatureRequestStatus @default(PREPARADO)
  documentChecksum String                 @map("document_checksum")
  finalDocumentId  String?                @unique @map("final_document_id")
  errorMessage     String?                @map("error_message") @db.Text
  preparedAt       DateTime               @default(now()) @map("prepared_at")
  sentAt           DateTime?              @map("sent_at")
  completedAt      DateTime?              @map("completed_at")
  cancelledAt      DateTime?              @map("cancelled_at")
  cancelledReason  String?                @map("cancelled_reason")
  createdById      String                 @map("created_by_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contract      SalesContract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  document      ContractDocument  @relation("SignatureSourceDocument", fields: [documentId], references: [id], onDelete: Restrict)
  finalDocument ContractDocument? @relation("SignatureFinalDocument", fields: [finalDocumentId], references: [id], onDelete: Restrict)
  parties       SignatureParty[]
  events        SignatureEvent[]

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, status])
  @@index([contractId])
  @@map("signature_requests")
}

/**
 * Signatário (item 4/5: comprador/co-comprador/representante/fiador/vendedor). `customerId`
 * opcional é só um cross-reference de conveniência para a UI — o registro histórico de QUEM
 * assinou é o SNAPSHOT (`displayName`/`email`/`role` fixados no momento em que a parte foi
 * incluída na request), por isso `onDelete: SetNull` no cliente é seguro (item 5: `Customer` pode
 * mudar/ser referenciado por outra coisa no futuro, a evidência de assinatura não deve depender
 * disso). Representante sem cadastro nunca vira `Customer` fictício — fica só com o snapshot.
 * `externalPartyId` é o id do signatário no provider (útil quando `SignatureRequest.provider =
 * CLICKSIGN`); nenhum CPF é armazenado aqui — se uma referência de identidade for necessária,
 * ela viaja mascarada dentro de `evidence` (Json), nunca em coluna própria.
 */
model SignatureParty {
  id              String               @id @default(cuid())
  requestId       String               @map("request_id")
  customerId      String?              @map("customer_id")
  externalPartyId String?              @map("external_party_id")
  displayName     String               @map("display_name")
  email           String?
  role            SignatoryRole
  order           Int                  @default(1)
  status          SignaturePartyStatus @default(PENDING)
  authMethod      String?              @map("auth_method")
  evidence        Json?
  signedAt        DateTime?            @map("signed_at")
  declinedAt      DateTime?            @map("declined_at")
  declinedReason  String?              @map("declined_reason")
  createdAt       DateTime             @default(now()) @map("created_at")

  request  SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([requestId, order])
  @@index([requestId, status])
  @@index([customerId])
  @@map("signature_parties")
}

/**
 * Projeção de DOMÍNIO da assinatura (item 3/4 do seu pedido) — não é uma segunda infraestrutura
 * de webhook. Transporte cru + idempotência de recebimento continuam 100% na 9H:
 * `IntegrationInboxEvent` (`@@unique([installationId, provider, eventId])`) é quem recebe/deduplica
 * o webhook HTTP real (quando existir um adapter Clicksign com `ConnectorInstallation` configurado).
 * `sourceInboxEventId` é o vínculo 1:1 opcional: no caminho "webhook real", o handler (1) upsert
 * idempotente em `IntegrationInboxEvent`, (2) só then cria a `SignatureEvent` correspondente — a
 * constraint `@unique` em `sourceInboxEventId` garante que um mesmo `IntegrationInboxEvent` nunca
 * gera duas projeções de domínio. No caminho MOCK/manual (sem transporte HTTP nenhum) o serviço
 * cria a `SignatureEvent` diretamente, com `sourceInboxEventId = null`, e evita duplicar a mesma
 * transição do mesmo jeito que o resto do arquivo faz idempotência de efeito — `updateMany` guardado
 * pelo `status` esperado de `SignatureRequest`/`SignatureParty` antes de gravar o evento (ver
 * `blockSalesUnit`/`confirmSalesReservation` em `sales-service.ts`), não uma segunda chave técnica.
 * ESTRITAMENTE append-only e imutável (item 4): não existe nenhum campo aqui sujeito a `UPDATE`
 * depois do `INSERT` — `occurredAt` (tempo do fato, do payload do provider quando houver) e
 * `recordedAt` (tempo em que a REDE gravou) são preenchidos uma única vez. Qualquer metadado
 * OPERACIONAL de processamento (retry, erro de validação de assinatura HMAC, `processedAt` do
 * recebimento) pertence a `IntegrationInboxEvent.status`/`processedAt` (9H, já mutável) — nunca a
 * este registro.
 */
model SignatureEvent {
  id                 String             @id @default(cuid())
  organizationId     String             @map("organization_id")
  requestId          String             @map("request_id")
  sourceInboxEventId String?            @unique @map("source_inbox_event_id")
  eventType          SignatureEventType @map("event_type")
  payload            Json?
  occurredAt         DateTime           @map("occurred_at")
  recordedAt         DateTime           @default(now()) @map("recorded_at")

  request          SignatureRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sourceInboxEvent IntegrationInboxEvent? @relation(fields: [sourceInboxEventId], references: [id], onDelete: SetNull)

  @@index([requestId, recordedAt])
  @@map("signature_events")
}

/**
 * Abstração `CreditBureauProvider` (item 5/7). `cpfMasked` é um SNAPSHOT já mascarado do CPF
 * checado no momento da consulta (auditoria imutável do que foi de fato verificado) — nunca o CPF
 * em claro, e nunca uma segunda cópia viva de `Customer.taxId` (que pode mudar depois). `score`/
 * `findingsSummary`/`result` só são preenchidos quando o provider efetivamente retorna algo — três
 * colunas nulas até lá, nunca um valor fabricado. `findingsSummary` é só o resumo mínimo
 * (contagens/categorias); NENHUM relatório bruto é persistido em coluna nenhuma deste model (LGPD).
 * Se um dia for necessário reter a resposta original do provider, a forma correta é reaproveitar o
 * MESMO `FileStorageProvider`/`ContractDocument`-like reference usado para documentos — não uma
 * coluna Json aberta aqui — e isso fica para quando essa necessidade for real, não hoje.
 * `retentionUntil` prepara o corte de governança LGPD (job de expurgo/anonimização fica para depois;
 * a coluna só marca até quando o registro pode ser mantido). `result` alimenta a alçada/política
 * existente (`ApprovalPolicy`, 9C) — nunca decide a venda sozinho.
 */
model CreditBureauConsultation {
  id                String                    @id @default(cuid())
  organizationId    String                    @map("organization_id")
  projectId         String?                   @map("project_id")
  customerId        String                    @map("customer_id")
  proposalId        String?                   @map("proposal_id")
  provider          CreditBureauProviderCode  @default(MOCK)
  purpose           CreditConsultationPurpose @default(SALE_PROPOSAL_ANALYSIS)
  status            CreditConsultationStatus  @default(REQUESTED)
  cpfMasked         String                    @map("cpf_masked")
  externalReference String?                   @map("external_reference")
  score             Int?
  findingsSummary   Json?                     @map("findings_summary")
  result            CreditConsultationResult?
  errorMessage      String?                   @map("error_message") @db.Text
  requestedById     String                    @map("requested_by_id")
  requestedAt       DateTime                  @default(now()) @map("requested_at")
  completedAt       DateTime?                 @map("completed_at")
  retentionUntil    DateTime?                 @map("retention_until")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  proposal     SalesProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId])
  @@index([proposalId])
  @@map("credit_bureau_consultations")
}

