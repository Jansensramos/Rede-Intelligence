  referenceMonth  DateTime                   @map("reference_month") @db.Date
  sourceType      String                     @map("source_type")
  sourceId        String                     @map("source_id")
  driver          String
  driverSnapshot  Json                       @map("driver_snapshot")
  sourceAmount    Decimal                    @map("source_amount") @db.Decimal(20, 2)
  allocatedAmount Decimal                    @map("allocated_amount") @db.Decimal(20, 2)
  residualAmount  Decimal                    @map("residual_amount") @db.Decimal(20, 2)
  proofZero       Boolean                    @map("proof_zero")
  status          AccountingRunStatus        @default(CALCULATED)
  checksum        String
  createdById     String                     @map("created_by_id")
  approvedById    String?                    @map("approved_by_id")
  createdAt       DateTime                   @default(now()) @map("created_at")
  lines           AccountingAllocationLine[]

  @@unique([organizationId, sourceType, sourceId, referenceMonth])
  @@index([organizationId, companyId, referenceMonth, status])
  @@map("accounting_allocation_runs")
}

model AccountingAllocationLine {
  id              String                  @id @default(cuid())
  runId           String                  @map("run_id")
  targetCompanyId String                  @map("target_company_id")
  targetProjectId String?                 @map("target_project_id")
  driverValue     Decimal                 @map("driver_value") @db.Decimal(20, 6)
  allocationRate  Decimal                 @map("allocation_rate") @db.Decimal(12, 9)
  allocatedAmount Decimal                 @map("allocated_amount") @db.Decimal(20, 2)
  run             AccountingAllocationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, targetCompanyId, targetProjectId])
  @@index([targetCompanyId, targetProjectId])
  @@map("accounting_allocation_lines")
}

model AccountingReconciliation {
  id                 String                         @id @default(cuid())
  organizationId     String                         @map("organization_id")
  companyId          String                         @map("company_id")
  projectId          String?                        @map("project_id")
  periodId           String                         @map("period_id")
  reconciliationType String                         @map("reconciliation_type")
  status             AccountingReconciliationStatus @default(OPEN)
  sourceAmount       Decimal                        @map("source_amount") @db.Decimal(20, 2)
  ledgerAmount       Decimal                        @map("ledger_amount") @db.Decimal(20, 2)
  differenceAmount   Decimal                        @map("difference_amount") @db.Decimal(20, 2)
  material           Boolean
  evidence           Json
  resolvedById       String?                        @map("resolved_by_id")
  resolvedAt         DateTime?                      @map("resolved_at")
  createdById        String                         @map("created_by_id")
  createdAt          DateTime                       @default(now()) @map("created_at")
  period             AccountingPeriod               @relation(fields: [periodId], references: [id], onDelete: Restrict)
  items              AccountingReconciliationItem[]

  @@unique([periodId, reconciliationType, projectId])
  @@index([organizationId, companyId, status, material])
  @@map("accounting_reconciliations")
}

model AccountingReconciliationItem {
  id               String                   @id @default(cuid())
  reconciliationId String                   @map("reconciliation_id")
  sourceType       String                   @map("source_type")
  sourceId         String                   @map("source_id")
  ledgerEntryId    String?                  @map("ledger_entry_id")
  sourceAmount     Decimal                  @map("source_amount") @db.Decimal(20, 2)
  ledgerAmount     Decimal                  @map("ledger_amount") @db.Decimal(20, 2)
  differenceAmount Decimal                  @map("difference_amount") @db.Decimal(20, 2)
  notes            String?
  reconciliation   AccountingReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)

  @@unique([reconciliationId, sourceType, sourceId])
  @@map("accounting_reconciliation_items")
}

model ConsolidationScope {
  id              String             @id @default(cuid())
  organizationId  String             @map("organization_id")
  economicGroupId String             @map("economic_group_id")
  name            String
  version         Int
  effectiveFrom   DateTime           @map("effective_from") @db.Date
  effectiveTo     DateTime?          @map("effective_to") @db.Date
  companies       Json
  method          String
  createdById     String             @map("created_by_id")
  approvedById    String?            @map("approved_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  runs            ConsolidationRun[]

  @@unique([organizationId, economicGroupId, name, version])
  @@index([organizationId, economicGroupId, effectiveFrom])
  @@map("consolidation_scopes")
}

model ConsolidationRun {
  id                 String                       @id @default(cuid())
  organizationId     String                       @map("organization_id")
  economicGroupId    String                       @map("economic_group_id")
  scopeId            String                       @map("scope_id")
  referenceMonth     DateTime                     @map("reference_month") @db.Date
  version            Int
  status             AccountingRunStatus          @default(DRAFT)
  individualAmount   Decimal                      @map("individual_amount") @db.Decimal(20, 2)
  adjustmentAmount   Decimal                      @default(0) @map("adjustment_amount") @db.Decimal(20, 2)
  eliminationAmount  Decimal                      @default(0) @map("elimination_amount") @db.Decimal(20, 2)
  consolidatedAmount Decimal                      @map("consolidated_amount") @db.Decimal(20, 2)
  proofZero          Boolean                      @map("proof_zero")
  checksum           String
  createdById        String                       @map("created_by_id")
  approvedById       String?                      @map("approved_by_id")
  createdAt          DateTime                     @default(now()) @map("created_at")
  scope              ConsolidationScope           @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  packages           ConsolidationPackage[]
  eliminations       ConsolidationElimination[]
  snapshot           ConsolidatedBalanceSnapshot?

  @@unique([scopeId, referenceMonth, version])
  @@index([organizationId, economicGroupId, referenceMonth, status])
  @@map("consolidation_runs")
}

model ConsolidationPackage {
  id                String           @id @default(cuid())
  runId             String           @map("run_id")
  companyId         String           @map("company_id")
  periodId          String           @map("period_id")
  closingSnapshotId String?          @map("closing_snapshot_id")
  debitTotal        Decimal          @map("debit_total") @db.Decimal(20, 2)
  creditTotal       Decimal          @map("credit_total") @db.Decimal(20, 2)
  netAmount         Decimal          @map("net_amount") @db.Decimal(20, 2)
  balances          Json
  checksum          String
  run               ConsolidationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, companyId])
  @@index([companyId, periodId])
  @@map("consolidation_packages")
}

model ConsolidationElimination {
  id              String           @id @default(cuid())
  runId           String           @map("run_id")
  fromCompanyId   String           @map("from_company_id")
  toCompanyId     String           @map("to_company_id")
  sourceType      String           @map("source_type")
  sourceId        String           @map("source_id")
  debitAccountId  String?          @map("debit_account_id")
  creditAccountId String?          @map("credit_account_id")
  amount          Decimal          @db.Decimal(20, 2)
  justification   String           @db.Text
  evidence        Json
  approvedById    String?          @map("approved_by_id")
  createdById     String           @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  run             ConsolidationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, sourceType, sourceId])
  @@index([fromCompanyId, toCompanyId])
  @@map("consolidation_eliminations")
}

model ConsolidatedBalanceSnapshot {
  id          String           @id @default(cuid())
  runId       String           @unique @map("run_id")
  balances    Json
  statements  Json
  checksum    String
  createdById String           @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  run         ConsolidationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@map("consolidated_balance_snapshots")
}

// ============================================================================
// FASE 9H — Central de Integrações, Conectores e Sincronização
