// ============================================================================
// FASE 9I (continuação) — Fundação de Quantidades BIM e Composições
// ============================================================================
//
// Fundação, não motor completo: liga BimElement (9A/8) a EconomicItem por
// mapeamento versionado e revisável (plano 9I, seção 14.1), e cria estrutura
// mínima de composição de custo (serviço → insumos/mão de obra/equipamento →
// coeficiente → produtividade → vigência, plano 9I, seção 14.2). Nenhum
// takeoff automático, nenhuma importação SINAPI, nenhum preço tratado como
// fato oficial — composição é referência versionada, não verdade de preço.

enum BimQuantityKind {
  LENGTH
  AREA
  VOLUME
  WEIGHT
  COUNT
}

enum QuantityExtractionMethod {
  MANUAL
  IFC_PROPERTY
  GEOMETRY_DERIVED
}

enum HumanReviewStatus {
  DRAFT
  REVIEWED
  APPROVED
  REJECTED
}

enum CompositionInputType {
  MATERIAL
  LABOR
  EQUIPMENT
}

model BimQuantityMapping {
  id                String                   @id @default(cuid())
  organizationId    String                   @map("organization_id")
  projectId         String                   @map("project_id")
  bimElementId      String                   @map("bim_element_id")
  economicItemId    String                   @map("economic_item_id")
  ifcClassification String                   @map("ifc_classification")
  quantityKind      BimQuantityKind          @map("quantity_kind")
  quantity          Decimal                  @db.Decimal(18, 4)
  unit              String
  extractionMethod  QuantityExtractionMethod @map("extraction_method")
  confidenceLevel   ConfidenceLevel          @map("confidence_level")
  provenance        Json
  version           Int                      @default(1)
  status            HumanReviewStatus        @default(DRAFT)
  reviewedById      String?                  @map("reviewed_by_id")
  reviewedAt        DateTime?                @map("reviewed_at")
  approvedById      String?                  @map("approved_by_id")
  approvedAt        DateTime?                @map("approved_at")
  rejectionReason   String?                  @map("rejection_reason") @db.Text
  checksum          String
  createdById       String                   @map("created_by_id")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bimElement   BimElement   @relation(fields: [bimElementId], references: [id], onDelete: Restrict)
  economicItem EconomicItem @relation(fields: [economicItemId], references: [id], onDelete: Restrict)

  @@unique([organizationId, bimElementId, economicItemId, version])
  @@index([organizationId, projectId, status])
  @@index([economicItemId])
  @@map("bim_quantity_mappings")
}

