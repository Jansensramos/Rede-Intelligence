model PurchaseRequisitionItem {
  id                 String                 @id @default(cuid())
  requisitionId      String                 @map("requisition_id")
  needId             String?                @map("need_id")
  economicItemId     String?                @map("economic_item_id")
  budgetLineItemId   String?                @map("budget_line_item_id")
  costCenterId       String?                @map("cost_center_id")
  description        String
  quantity           Decimal                @db.Decimal(18, 4)
  unit               String
  estimatedUnitPrice Decimal?               @map("estimated_unit_price") @db.Decimal(20, 2)
  requiredAt         DateTime?              @map("required_at") @db.Date
  sortOrder          Int                    @default(0) @map("sort_order")
  requisition        PurchaseRequisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  need               ProcurementNeed?       @relation(fields: [needId], references: [id], onDelete: Restrict)
  economicItem       EconomicItem?          @relation(fields: [economicItemId], references: [id], onDelete: Restrict)
  budgetLineItem     BudgetLineItem?        @relation(fields: [budgetLineItemId], references: [id], onDelete: Restrict)
  costCenter         CostCenter?            @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  proposalItems      SupplierProposalItem[]

  @@unique([requisitionId, needId])
  @@index([economicItemId])
  @@map("purchase_requisition_items")
}

model ProcurementSpecification {
  id                 String              @id @default(cuid())
  requisitionId      String              @map("requisition_id")
  version            Int
  title              String
  scope              String              @db.Text
  requirements       Json
  deliveryLocation   String?             @map("delivery_location")
