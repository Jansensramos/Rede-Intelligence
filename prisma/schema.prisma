  createdById    String                @map("created_by_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  package        DesignProjectPackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  rules          DesignRule[]

  @@unique([organizationId, name, version])
  @@index([organizationId, active, municipality, state])
  @@map("design_rule_sets")
}

model DesignRule {
  id            String            @id @default(cuid())
  ruleSetId     String            @map("rule_set_id")
  key           String
  title         String
  description   String            @db.Text
  applicability Json
  comparator    String
  requiredValue Decimal?          @map("required_value") @db.Decimal(20, 6)
  unit          String?
  tolerance     Decimal?          @db.Decimal(12, 6)
  sourceRef     String            @map("source_ref")
  enabled       Boolean           @default(true)
  ruleSet       DesignRuleSet     @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  checks        DesignRuleCheck[]

  @@unique([ruleSetId, key])
  @@map("design_rules")
}

model DesignRuleCheck {
  id             String                @id @default(cuid())
  ruleId         String                @map("rule_id")
  revisionId     String                @map("revision_id")
  status         DesignRuleCheckStatus
  measuredValue  Decimal?              @map("measured_value") @db.Decimal(20, 6)
  requiredValue  Decimal?              @map("required_value") @db.Decimal(20, 6)
  evidence       Json
  confidence     DesignConfidence
  reviewRequired Boolean               @default(true) @map("review_required")
  createdAt      DateTime              @default(now()) @map("created_at")
  rule           DesignRule            @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  revision       DesignRevision        @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([ruleId, revisionId])
  @@index([revisionId, status])
  @@map("design_rule_checks")
}

model DetectedUnit {
  id                 String           @id @default(cuid())
  revisionId         String           @map("revision_id")
  sourceFileId       String?          @map("source_file_id")
  sourceSheetId      String?          @map("source_sheet_id")
  unitKey            String           @map("unit_key")
  unitType           String           @map("unit_type")
  floor              String?
  tower              String?
  privateArea        Decimal?         @map("private_area") @db.Decimal(12, 4)
  balconyArea        Decimal?         @map("balcony_area") @db.Decimal(12, 4)
  rooms              Int?
  bathrooms          Int?
  parkingAssociation String?          @map("parking_association")
  confidence         DesignConfidence
  origin             DesignDataOrigin
  geometryRef        Json?            @map("geometry_ref")
  revision           DesignRevision   @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, unitKey])
  @@index([revisionId, tower, floor, unitType])
  @@map("detected_units")
}

model DesignClash {
  id             String                @id @default(cuid())
  modelId        String?               @map("model_id")
  revisionId     String                @map("revision_id")
  elementAId     String?               @map("element_a_id")
  elementBId     String?               @map("element_b_id")
  clashType      BimClashType          @map("clash_type")
  elementA       Json                  @map("element_a")
  elementB       Json                  @map("element_b")
  geometry       Json
  coordinate     Json?
  description    String                @default("") @db.Text
  severity       DesignFindingSeverity
  confidence     DesignConfidence
  status         BimClashStatus        @default(OPEN)
  origin         DesignDataOrigin      @default(CALCULATED)
  clearanceMm    Decimal?              @map("clearance_mm") @db.Decimal(12, 4)
  ownerId        String?               @map("owner_id")
  findingId      String?               @map("finding_id")
  resolvedAt     DateTime?             @map("resolved_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  model          BimModel?             @relation(fields: [modelId], references: [id], onDelete: Cascade)
  elementARecord BimElement?           @relation("BimClashElementA", fields: [elementAId], references: [id], onDelete: SetNull)
  elementBRecord BimElement?           @relation("BimClashElementB", fields: [elementBId], references: [id], onDelete: SetNull)
  revision       DesignRevision        @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId, status, severity])
  @@map("design_clashes")
}

model DesignDecision {
  id           String               @id @default(cuid())
  packageId    String               @map("package_id")
  revisionId   String               @map("revision_id")
  title        String
  rationale    String               @db.Text
  evidence     Json
  impact       Json?
  approvedById String?              @map("approved_by_id")
  createdById  String               @map("created_by_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  package      DesignProjectPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  revision     DesignRevision       @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@index([packageId, revisionId, createdAt])
  @@map("design_decisions")
}

model DesignAuditLog {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  packageId      String               @map("package_id")
  userId         String               @map("user_id")
  action         String
  entityType     String               @map("entity_type")
  entityId       String               @map("entity_id")
  before         Json?
  after          Json?
  metadata       Json?
  createdAt      DateTime             @default(now()) @map("created_at")
  package        DesignProjectPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([organizationId, packageId, createdAt])
  @@index([entityType, entityId])
  @@map("design_audit_logs")
}
